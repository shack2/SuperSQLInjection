<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iri="https://irihi.tech/shared"
    xmlns:semi="https://irihi.tech/semi"
    
    xmlns:semiae="clr-namespace:Semi.Avalonia.AvaloniaEdit;assembly=Semi.Avalonia.AvaloniaEdit">


    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <semi:SemiPopupAnimations />
    <!--  AvaloniaEdit 的 Semi 主题（SearchPanel/TextArea/补全列表等按 Semi 令牌配色，浅深色自适应）；
         缺它时 Ctrl+F 搜索面板回落 -->
    <semiae:AvaloniaEditSemiTheme />

    <!--  全局图标尺寸统一  -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

        <!--  全局 ComboBox 统一带边框样式  -->
    <Style Selector="ComboBox">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="iri:ClassHelper.Classes" Value="Bordered" />
        <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
    </Style>
     
      <Style Selector="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
    </Style>
     <Style Selector="TextBox">
        <Setter Property="FontWeight" Value="Normal" />
         <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
     

</Styles>
