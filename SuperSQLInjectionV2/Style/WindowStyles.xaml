<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  窗口级样式（标题栏右侧 GitHub 仓库按钮，原 TitleBarRightContent 局部样式上收）  -->
        <!--  仓库跳转按钮：透明底，悬停/按下淡染主色（Semi模板触发器盖Button.Background，需同时定位ContentPresenter）  -->
        <Style Selector="Button.repo">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.repo:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint2}" />
        </Style>
        <Style Selector="Button.repo:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint2}" />
        </Style>
        <Style Selector="Button.repo:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
        </Style>
        <Style Selector="Button.repo:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
        </Style>
</Styles>
