<UserControl
    x:Class="SuperSQLInjectionV2.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SuperSQLInjectionV2.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iri="https://irihi.tech/shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SuperSQLInjectionV2.Models"
    xmlns:bypass="using:SuperSQLInjectionV2.Bypass"
    xmlns:detectmodels="using:SuperSQLInjectionV2.Models.Detect"
    xmlns:helper="using:SuperSQLInjectionV2.Models.Data"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:AvaloniaEditor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:vm="using:SuperSQLInjectionV2.ViewModels"
    xmlns:views="clr-namespace:SuperSQLInjectionV2.Views"
    d:DesignHeight="1050"
    d:DesignWidth="1500"
    x:CompileBindings="True"
    x:DataType="vm:MainViewViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewViewModel />
    </Design.DataContext>
    <Panel>
        <Panel.Resources>
            <converters:TreeViewIconConverter x:Key="TreeViewIconConverter">
                <StaticResource x:Key="IconDataBase" ResourceKey="IconDataBase" />
                <StaticResource x:Key="IconTable" ResourceKey="IconTable" />
                <StaticResource x:Key="IconColumn" ResourceKey="IconColumn" />
            </converters:TreeViewIconConverter>
            <converters:StringEqualityConverter x:Key="StringEqualityConverter" />
            <converters:InjectTypeNameConverter x:Key="InjectTypeNameConverter" />
            <converters:InjectTypeBadgeConverter x:Key="InjectTypeBadgeConverter" />
            <!--  Lucide 线性图标（24x24 坐标系，Stroke 渲染，源：lucide-static ISC）  -->
            <StreamGeometry x:Key="LgDatabaseZap">M3,5 A9,3 0 1 0 21,5 A9,3 0 1 0 3,5 Z M3 5V19A9 3 0 0 0 15 21.84 M21 5V8 M21 12L18 17H22L19 22 M3 12A9 3 0 0 0 14.59 14.87</StreamGeometry>
            <StreamGeometry x:Key="LgRadar">M19.07 4.93A10 10 0 0 0 6.99 3.34 M4 6h.01 M2.29 9.62A10 10 0 1 0 21.31 8.35 M16.24 7.76A6 6 0 1 0 8.23 16.67 M12 18h.01 M17.99 11.66A6 6 0 0 1 15.77 16.67 M10,12 A2,2 0 1 0 14,12 A2,2 0 1 0 10,12 Z M13.41 10.59L19.07 4.93</StreamGeometry>
            <StreamGeometry x:Key="LgTerminal">M12 19h8 M4 17l6-6-6-6</StreamGeometry>
            <StreamGeometry x:Key="LgHome">M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10</StreamGeometry>
            <StreamGeometry x:Key="LgDatabase">M3,5 A9,3 0 1 0 21,5 A9,3 0 1 0 3,5 Z M3 5V19A9 3 0 0 0 21 19V5 M3 12A9 3 0 0 0 21 12</StreamGeometry>
            <StreamGeometry x:Key="LgTable2">M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18</StreamGeometry>
            <StreamGeometry x:Key="LgGlobe">M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20</StreamGeometry>
            <StreamGeometry x:Key="LgShieldAlert">M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M12 8v4 M12 16h.01</StreamGeometry>
            <StreamGeometry x:Key="LgBinary">M16,14 A2,2 0 0 1 18,16 V18 A2,2 0 0 1 16,20 A2,2 0 0 1 14,18 V16 A2,2 0 0 1 16,14 Z M8,4 A2,2 0 0 1 10,6 V8 A2,2 0 0 1 8,10 A2,2 0 0 1 6,8 V6 A2,2 0 0 1 8,4 Z M6 20h4 M14 10h4 M6 14h2v6 M14 4h2v6</StreamGeometry>
            <StreamGeometry x:Key="LgScrollText">M15 12h-5 M15 8h-5 M19 17V5a2 2 0 0 0-2-2H4 M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3</StreamGeometry>
            <StreamGeometry x:Key="LgMoon">M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401</StreamGeometry>
            <StreamGeometry x:Key="LgTemplate">M3,3 H21 V10 H3 Z M3,14 H21 V21 H3 Z</StreamGeometry>
            <StreamGeometry x:Key="LgSun">M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 Z M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M6.34 17.66l-1.41 1.41 M19.07 4.93l-1.41 1.41</StreamGeometry>
            <StreamGeometry x:Key="LgLock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4</StreamGeometry>
            <StreamGeometry x:Key="LgServer">M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M4 14h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z M6 6h.01 M6 18h.01</StreamGeometry>
            <StreamGeometry x:Key="LgSignal">M2 20h.01 M7 20v-4 M12 20v-8 M17 20V8 M22 4v16</StreamGeometry>
            <StreamGeometry x:Key="LgUser">M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M8,7 A4,4 0 1 0 16,7 A4,4 0 1 0 8,7 Z</StreamGeometry>
            <StreamGeometry x:Key="LgBookOpen">M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z</StreamGeometry>
            <StreamGeometry x:Key="LgRepeat">M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3</StreamGeometry>
            <StreamGeometry x:Key="LgTimer">M10 2h4 M12 14v-4 M5,14 A7,7 0 1 0 19,14 A7,7 0 1 0 5,14 Z</StreamGeometry>
            <StreamGeometry x:Key="LgArrowLeftRight">M8 3L4 7l4 4 M4 7h16 M16 21l4-4-4-4 M20 17H4</StreamGeometry>
            <StreamGeometry x:Key="LgFileCode">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M10 13l-2 2 2 2 M14 17l2-2-2-2</StreamGeometry>
            <StreamGeometry x:Key="LgDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>
            <StreamGeometry x:Key="LgChevronsLeft">M11 17l-5-5 5-5 M18 17l-5-5 5-5</StreamGeometry>
            <StreamGeometry x:Key="LgChevronsRight">M6 17l5-5-5-5 M13 17l5-5-5-5</StreamGeometry>
            <StreamGeometry x:Key="LgInfo">M12,22 A10,10 0 1 0 12,2 A10,10 0 1 0 12,22 Z M12 16v-4 M12 8h.01</StreamGeometry>
            <StreamGeometry x:Key="LgSend">M22 2L11 13 M22 2l-7 20-4-9-9-4 20-7z</StreamGeometry>
            <!--  lucide: refresh-cw（软件更新卡片）  -->
            <StreamGeometry x:Key="LgRefreshCw">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M3 21v-5h5</StreamGeometry>
            <!--  请求配置工具栏细线图标（lucide：braces / crosshair / sparkles，Stroke渲染；braces垂直占满3-21，与文字居中对齐更稳）  -->
            <StreamGeometry x:Key="LgCode">M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1 M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1</StreamGeometry>
            <StreamGeometry x:Key="LgCrosshair">M22,12 A10,10 0 1 0 2,12 A10,10 0 1 0 22,12 Z M22 12h-4 M6 12H2 M12 6V2 M12 22v-4</StreamGeometry>
            <StreamGeometry x:Key="LgSparkles">M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z M5 3v4 M3 5h4 M19 17v4 M17 19h4</StreamGeometry>
            <StreamGeometry x:Key="LgSearch">M19 11A8 8 0 1 0 3 11 8 8 0 1 0 19 11Z M21 21l-4.35-4.35</StreamGeometry>
            <StreamGeometry x:Key="LgCircleCheck">M21.8 10A10 10 0 1 1 17 3.34 M9 11l3 3L22 4</StreamGeometry>
        </Panel.Resources>
        <Panel.Styles>
            <Style Selector="Grid.Blur">
                <Setter Property="Effect" Value="blur(10)" />
            </Style>
              <Style Selector="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
            </Style>
            <!--  ======== 设计稿组件样式（对应 pages/主界面·浅色主题.html） ========  -->
            <!--  卡片面板  -->
            <Style Selector="Border.panel">
                <Setter Property="Background" Value="{DynamicResource DsgCard}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <!--  扁平通栏页面底板：无圆角无边框，靠分隔线分区（IDE 风格）  -->
            <Style Selector="Border.pageflat">
                <Setter Property="Background" Value="{DynamicResource DsgCard}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <!--  左侧导航项  -->
            <Style Selector="Button.navitem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="13" />
                <!--  菜单文字用Light字重（300）：Inter/YaHei的Regular笔画偏厚，Light更接近设计稿观感；选中态SemiBold保持对比  -->
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.navitem:pointerover">
                <Setter Property="Background" Value="{DynamicResource DsgNavHover}" />
            </Style>
            <!--  模板触发器会盖住Button.Background（Semi主题），悬停背景需同时定位模板内ContentPresenter  -->
            <Style Selector="Button.navitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DsgNavHover}" />
            </Style>
            <Style Selector="Button.navitem.active">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!--  Lucide 线性导航图标：描边渲染，随导航状态变色  -->
            <Style Selector="Path.luc">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Stroke" Value="{DynamicResource DsgInk2}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeLineCap" Value="Round" />
                <Setter Property="StrokeJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  导航项内图标：比全局luc更浅一档、描边更细（仅菜单范围生效）  -->
            <Style Selector="Button.navitem Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgNavIcon}" />
                <Setter Property="StrokeThickness" Value="1.5" />
            </Style>
            <Style Selector="Button.navitem:pointerover Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgInk2}" />
            </Style>
            <Style Selector="Button.navitem.active Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  导航分组标题  -->
            <Style Selector="TextBlock.navcaption">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="Margin" Value="10,12,10,5" />
            </Style>
            <!--  配置条  -->
            <Style Selector="Border.cfgstrip">
                <Setter Property="Background" Value="{DynamicResource DsgCard}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,4" />
            </Style>
            <Style Selector="Border.cfglabel">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0,0" />
                <Setter Property="Height" Value="22" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <!--  通道配置分组：经典 GroupBox 外观（标题骑跨上边框，4px圆角，DsgBorder描边）  -->
            <Style Selector="GroupBox.chgrp">
                <Setter Property="Padding" Value="10,5,10,10" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.RowSpan="2" BorderBrush="{DynamicResource DsgBorder}" BorderThickness="1" CornerRadius="4" Margin="0,9,0,0" />
                            <Border Background="{DynamicResource DsgCard}" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="5,1">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  TextElement.FontSize="14" 
                                                  TextElement.Foreground="{DynamicResource DsgPrimary}" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="Border.cfglabel TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  编辑器面板头部子页签  -->
            <Style Selector="Button.subtab">
                <Setter Property="Background" Value="Transparent" />
                <!--  预留2px底边占位：选中态只改BorderBrush不位移，与TabItem选中下划线同款  -->
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Height" Value="37" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.subtab:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DsgInk1}" />
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <Style Selector="Button.subtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <!--  选中态对齐TabItem三要素：主色文字+主色图标+2px主色下划线，字重Normal（避免中文合成加粗变形）  -->
            <Style Selector="Button.subtab.active">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Button.subtab.active:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Button.subtab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <!--  标签选择按钮组（文件操作方式等，active=选中）  -->
            <Style Selector="Button.tagbtn">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.tagbtn:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <Style Selector="Button.tagbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <Style Selector="Button.tagbtn.active">
                <Setter Property="Background" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!--  迷你按钮（复制/换行/清空/导出等）  -->
            <Style Selector="Button.minibtn">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.minibtn:pointerover">
                <!--  用DsgPrimary而非SemiColorPrimary：浅色两者同为#2563EB，深色下DsgPrimary是亮青#22D3EE（SemiColorPrimary深青#0891B2做文字太闷）  -->
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />

            </Style>
            <!--  Semi主题的Button悬停/按下背景写在模板ContentPresenter上（模板触发器盖过Button.Background的TemplateBinding），
                  悬停/按下背景必须定位到模板内部的PART_ContentPresenter才生效  -->
            <Style Selector="Button.minibtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgPrimaryTint2}" />
            </Style>
            <Style Selector="Button.minibtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimaryPointerover}" />
            </Style>
            <!--  minibtn内细线图标：比全局luc更小更细，悬浮随文字加深  -->
            <Style Selector="Button.minibtn Path.luc">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="StrokeThickness" Value="1.75" />
            </Style>
            <Style Selector="Button.minibtn:pointerover Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  日志过滤 chips  -->
            <Style Selector="Button.chip">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.chip:pointerover">
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <Style Selector="Button.chip.on">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>


            <!--  概览面板 kv 行  -->
            <Style Selector="Border.kvrow">
                <Setter Property="Padding" Value="10" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="Height" Value="35" />
            </Style>
            <Style Selector="TextBlock.kvkey">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBlock.kvval">
                <Setter Property="FontSize" Value="12" />
                <!--  值文本用最深的主题墨色（浅色主题下近黑；随暗色主题自动反白，不写死纯黑防止暗色不可读）  -->
                <Setter Property="Foreground" Value="{DynamicResource DsgInk1}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  工具列面板标题  -->
            <Style Selector="TextBlock.toolshead">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
            </Style>
            <!--  状态栏徽章（无底色纯文字，Padding仅作间距）  -->
            <Style Selector="Border.sbbadge">
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Border.sbbadge TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  状态栏分隔线  -->
            <Style Selector="Border.sbsep">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Background" Value="{DynamicResource DsgLineStrong}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0" />
            </Style>
            <!--  数据读取页：页头  -->
            <Style Selector="Border.phead">
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="Background" Value="{DynamicResource DsgCard}" />
            </Style>
            <!--  数据读取页：子面板头  -->
            <Style Selector="Border.subhead">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource DsgBorder}" />
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <!--  数据读取页：当前对象路径徽章  -->
            <Style Selector="Border.dtpath">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Border.dtpath TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  数据读取页：工具条分隔线  -->
            <Style Selector="Border.dtvsep">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Background" Value="{DynamicResource DsgLineStrong}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="2,0" />
            </Style>
            <!--  数据读取页：总条数徽章  -->
            <Style Selector="Border.dttotal">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style Selector="Border.dttotal TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <!--  顶部横排选项卡（数据管理/防护绕过等）：默认主题VerticalAlignment=Center会让2px选中下划线浮空，
                  改为Stretch贴底；前景色统一走Dsg令牌（悬停/选中高度一致，只变色不变高）  -->
            <Style Selector="TabControl:not(.sidetabs) > TabItem">
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource DsgInk2}" />
                <!--  行高+5px：默认垂直padding 4+4，提到6.5+6.5  -->
                <Setter Property="Padding" Value="8,6.5" />
            </Style>
            <Style Selector="TabControl:not(.sidetabs) > TabItem:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource DsgInk1}" />
            </Style>
            <Style Selector="TabControl:not(.sidetabs) > TabItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  Semi选中态会把表头切成SemiBold（TabItemSelectedFontWeight），中文合成加粗字形变形；
                  选中态已有亮青文字+下划线指示，字重压回Normal（需打到模板内的PART_HeaderPresenter才生效）  -->
            <Style Selector="TabControl:not(.sidetabs) > TabItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="FontWeight" Value="Normal" />
                <!--  选中文字色同样被Semi写在模板此节点上（TabItemLineHeaderSelectedForeground），
                      必须在这里覆盖才能跟随DsgPrimary主题色（浅色蓝/深色青）  -->
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  悬停文字色同样打到模板节点（Semi冻结的Text0），保证跟随DsgInk1  -->
            <Style Selector="TabControl:not(.sidetabs) > TabItem:pointerover:not(:selected) /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="Foreground" Value="{DynamicResource DsgInk1}" />
            </Style>
            <!--  表头内联图标（Path.luc 的 Stroke / 请求包响应包的 PathIcon）随选中/悬停变色  -->
            <Style Selector="TabControl:not(.sidetabs) > TabItem:pointerover:not(:selected) Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgInk1}" />
            </Style>
            <Style Selector="TabControl:not(.sidetabs) > TabItem:selected Path.luc">
                <Setter Property="Stroke" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  注意：必须限定在 /template/ ContentPresenter#PART_HeaderPresenter 内，
                  裸后代选择器会命中选项卡内容区里所有 PathIcon（曾把 CheckBox 对勾染成主色导致"实心方块"）  -->
            <Style Selector="TabControl:not(.sidetabs) > TabItem:pointerover:not(:selected) /template/ ContentPresenter#PART_HeaderPresenter PathIcon">
                <Setter Property="Foreground" Value="{DynamicResource DsgInk1}" />
            </Style>
            <Style Selector="TabControl:not(.sidetabs) > TabItem:selected /template/ ContentPresenter#PART_HeaderPresenter PathIcon">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  库表列树：选中行高亮  -->
            <Style Selector="TreeViewItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
            </Style>
            <!--  左侧竖排选项卡（防护绕过/注入操作）：整行等宽菜单化，选中态铺满整行  -->
            <Style Selector="TabControl.sidetabs > TabItem">
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="TabControl.sidetabs > TabItem:pointerover">
                <Setter Property="Background" Value="{DynamicResource DsgSurface2}" />
            </Style>
            <Style Selector="TabControl.sidetabs > TabItem:selected">
                <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
                <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Panel.Styles>

        <Grid Background="{DynamicResource DsgBg}" Margin="0,0,0,0">
            <Grid ColumnDefinitions="Auto,*">

                <!--  ============ 左侧导航（可折叠：窄栏仅图标） ============  -->
                <Border Grid.Column="0"
                        Width="{Binding NavSidebarWidth}"
                        Background="{DynamicResource DsgSidebar}"
                        BorderBrush="{DynamicResource DsgBorder}"
                        BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,14,10,12">
                        <!--  折叠/展开开关（吸底）  -->
                        <Button Classes="navitem" DockPanel.Dock="Bottom"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ToggleNavCollapseCommand}">
                            <ToolTip.Tip>
                                <TextBlock Text="折叠/展开导航" />
                            </ToolTip.Tip>
                            <Panel>
                                <Path Classes="luc" Data="{StaticResource LgChevronsLeft}" IsVisible="{Binding !IsNavCollapsed}" />
                                <Path Classes="luc" Data="{StaticResource LgChevronsRight}" IsVisible="{Binding IsNavCollapsed}" />
                            </Panel>
                        </Button>
                        <!--  导航列表  -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="2">
                                <!--  品牌（软件标题显示在菜单上方）  -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,2,6,10">
                                    <Border Width="34" Height="34" CornerRadius="4"
                                            BoxShadow="0 4 10 -4 #662563EB">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="20%,0%" EndPoint="80%,100%">
                                                <GradientStop Color="{DynamicResource DsgPrimaryColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource DsgPrimaryHoverColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Path Classes="luc" Data="{StaticResource LgDatabaseZap}" Stroke="#FFFFFF" Width="18" Height="18" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="超级SQL注入工具V2" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                           
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppVersionText}" FontSize="12"
                                                   Foreground="{DynamicResource DsgInk2}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Classes="navcaption" Text="检 测" IsVisible="{Binding !IsNavCollapsed}" />
                                <Button Classes="navitem" Classes.active="{Binding NavPage0Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgRadar}" />
                                        <TextBlock Text="注入检测" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage10Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgFileCode}" />
                                        <TextBlock Text="检测用例" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage3Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="3">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Path Classes="luc" Data="{StaticResource LgDatabase}" />
                                            <TextBlock Text="注入记录" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource DsgSurface3}"
                                                CornerRadius="4" MinWidth="20" Height="18" Padding="6,0"
                                                VerticalAlignment="Center">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasInjectRecords" />
                                                    <Binding Path="!IsNavCollapsed" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <TextBlock Text="{Binding InjectRecords.Count}" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource DsgInk2}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>

                                <TextBlock Classes="navcaption" Text="数 据" IsVisible="{Binding !IsNavCollapsed}" />
                                <Button Classes="navitem" Classes.active="{Binding NavPage4Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgTable2}" />
                                        <TextBlock Text="数据管理" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage9Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="9">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgTemplate}" />
                                        <TextBlock Text="取数模版" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Classes="navcaption" Text="工 具" IsVisible="{Binding !IsNavCollapsed}" />
                                <Button Classes="navitem" Classes.active="{Binding NavPage5Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="5">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgGlobe}" />
                                        <TextBlock Text="网络设置" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage6Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgShieldAlert}" />
                                        <TextBlock Text="防护绕过" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage7Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="7">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgBinary}" />
                                        <TextBlock Text="编码工具" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="navitem" Classes.active="{Binding NavPage8Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgScrollText}" />
                                        <TextBlock Text="请求日志" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Classes="navcaption" Text="帮 助" IsVisible="{Binding !IsNavCollapsed}" />
                                <Button Classes="navitem" Classes.active="{Binding NavPage11Visible}"
                                        Command="{Binding SelectNavCommand}" CommandParameter="11">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="luc" Data="{StaticResource LgInfo}" />
                                        <TextBlock Text="关于" VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--  ============ 右侧主列 ============  -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,32" Margin="0,0,0,0">

                    <!--  面包屑位置标识（卡片式：首页 › 当前页胶囊，所有页面统一置顶）  -->
                    <Border Grid.Row="0" Height="40">
                        <Border Padding="15,5" HorizontalAlignment="Left"
                                BoxShadow="0 1 3 0 #0D1B2A14">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Path Data="{StaticResource LgHome}" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{DynamicResource DsgInk3}" StrokeThickness="1.5"
                                      StrokeLineCap="Round" Fill="Transparent" />
                                <TextBlock Text="首页" FontSize="14" Foreground="{DynamicResource DsgInk3}" VerticalAlignment="Center" />
                                <Path Data="M9 5l6 6-6 6" Width="12" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{DynamicResource DsgInk3}" StrokeThickness="1.5"
                                      StrokeLineCap="Round" Fill="Transparent" />
                                <Border  VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NavCurrentPageName}" FontSize="14"  Foreground="{DynamicResource DsgPrimary}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  目标命令栏（URL+公共配置合一卡片，仅注入检测页显示；数据操作页的公共配置已并入注入配置卡片）  -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding NavPage0Visible}"
                            Background="{DynamicResource DsgCard}"
                            BorderBrush="{DynamicResource DsgBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="12,0" RowDefinitions="Auto,Auto,Auto">
                            <!--  URL行（仅注入检测页）  -->
                            <Grid Grid.Row="1" IsVisible="{Binding NavPage0Visible}" Height="58" ColumnDefinitions="Auto,*,Auto,Auto">
                                
                                <Grid Grid.Column="1" Margin="0,0">
                                    <TextBox HorizontalAlignment="Stretch" Classes="Bordered"
                                             Text="{Binding AppConfig.Url}"
                                             VerticalAlignment="Center" Padding="32,0,0,0"
                                             FontFamily="{StaticResource CodeFontFamily}"
                                             FontSize="12.5"
                                             PlaceholderText="http://target/page?id=1" />
                                    <PathIcon Data="{StaticResource IconHttpRequest}" Width="14" Height="14"
                                              IsHitTestVisible="False" Foreground="{DynamicResource DsgInk3}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Border IsHitTestVisible="False"
                                            IsVisible="{Binding HasInjectRecords}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Height="22" Padding="8,0" CornerRadius="4"
                                            Background="{DynamicResource DsgPrimaryTint}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DsgPrimary}"
                                                   Text="{Binding InjectRecords.Count, StringFormat={}{0} 个注入点}" />
                                    </Border>
                                </Grid>
                                <u:IconButton Grid.Column="2" Margin="8,0,8,0"
                                              Classes="Danger"
                                              Icon="{StaticResource SemiIconStop}"
                                              Theme="{DynamicResource OutlineIconButton}"
                                              Content="停 止"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !NavPage4Visible}"
                                              Command="{Binding StopAllCommand}" />
                                <u:IconButton Grid.Column="3"
                                              Icon="{StaticResource SemiIconPlay}"
                                              IsLoading="{Binding AppConfig.IsRuning}"
                                              Theme="{DynamicResource SolidIconButton}"
                                              Content="检 测"
                                              IsEnabled="{Binding !AppConfig.IsRuning}"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !NavPage4Visible}"
                                              Command="{Binding StartCheckInjectCommand}" />
                            </Grid>
                            <!--  线程/端口/SSL（全页面共用）+ 检测参数（仅注入检测页）；网页解码/代理以网络设置页配置为准，取数编码在数据操作页注入配置卡片  -->
                            <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="4" Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Classes="kvkey" Text="线程：" />
                                <ComboBox Width="62" ItemsSource="{Binding AppConfig.ThreadSizeItems}"
                                          SelectedValue="{Binding AppConfig.ThreadSize}" VerticalAlignment="Center" />
                                <Border Classes="dtvsep" />
                                <TextBlock Text="端口：" Classes="kvkey" />
                                <TextBox Width="62" Classes="Bordered" VerticalAlignment="Center" Text="{Binding AppConfig.Port}" />
                                <CheckBox Content="SSL" IsChecked="{Binding AppConfig.IsSSL}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NavPage0Visible}" VerticalAlignment="Center">
                                    <Border Classes="dtvsep" />
                                    <TextBlock Text="级别：" Classes="kvkey" />
                                    <ComboBox Width="52" ItemsSource="{Binding AppConfig.DataConfig.DetectLevels}" SelectedItem="{Binding AppConfig.DataConfig.DetectLevel}" VerticalAlignment="Center" />
                                    <TextBlock Text="风险：" Classes="kvkey" />
                                    <ComboBox Width="52" ItemsSource="{Binding AppConfig.DataConfig.DetectRisks}" SelectedItem="{Binding AppConfig.DataConfig.DetectRisk}" VerticalAlignment="Center" />
                                    <CheckBox Content="智能模式" IsChecked="{Binding AppConfig.DataConfig.SmartMode}" VerticalAlignment="Center" ToolTip.Tip="智能模式：启发式无任何迹象（非动态参数+无错误指纹）时跳过深度检测；非动态参数跳过页面比对类技术，仅保留时间/堆叠" />
                                    <CheckBox Content="穷举模式" IsChecked="{Binding AppConfig.DataConfig.DetectExhaustive}" VerticalAlignment="Center" ToolTip.Tip="默认命中一个用例即跳到下一技术（省时）；开启后同技术内继续测完剩余用例/边界，注入记录给出同技术多个命中（更完整画像，发包更多）" />
                                    <CheckBox Content="DNS外带探测" IsChecked="{Binding AppConfig.DataConfig.DetectDnsOob}" VerticalAlignment="Center" ToolTip.Tip="触发数据库向DNSLog域名发起DNS解析，平台侧回收确认（不依赖页面响应，可发现无回显无延时的盲注）。需先在网络设置配置DNSLog域名+API Token" />
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <!--  ============ 页面区（7页叠放切换，通栏铺满与URL栏/状态栏对齐） ============  -->
                    <Grid Grid.Row="2" RowDefinitions="*">

                        <!--  ======== P0 扫描注入 ========  -->
                        <Grid IsVisible="{Binding NavPage0Visible}" RowDefinitions="*">

                            <!--  工作区  -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <!--  请求报文面板（扁平通栏，右侧1px分隔线）  -->
                                <Border Classes="pageflat" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DsgBorder}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Height="38" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Classes="subtab" Classes.active="{Binding RequestSubTab0Visible}"
                                                        Command="{Binding SelectRequestSubTabCommand}" CommandParameter="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource IconHttpRequest}" Width="13.5" Height="13.5" />
                                                        <TextBlock Text="请求报文" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="subtab" Classes.active="{Binding RequestSubTab3Visible}"
                                                        Command="{Binding SelectRequestSubTabCommand}" CommandParameter="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource IconSkipParam}" Width="13.5" Height="13.5" />
                                                        <TextBlock Text="跳过参数" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                       
                                        <Grid Background="{DynamicResource DsgCodeBg}">
                                            <!--  子页0：请求报文编辑器（检测页独立文档，永不写入利用标记）  -->
                                            <AvaloniaEditor:TextEditor IsVisible="{Binding RequestSubTab0Visible}"
                                                                     FontFamily="{StaticResource CodeFontFamily}"
                                                                     Name="RequestTxtBox"
                                                                     ShowLineNumbers="True"
                                                                     Document="{Binding AppConfig.TxtDetectRequest}"
                                                                     HorizontalScrollBarVisibility="Auto"
                                                                     VerticalScrollBarVisibility="Visible"
                                                                     Watermark="请复制注入点HTTP请求数据包">
                                                <AvaloniaEditor:TextEditor.ContextMenu>
                                                    <ContextMenu Opened="RequestMenuOpenedC">
                                                        <MenuItem Header="根据URL生成请求包" Click="BuildRequestFromUrlC">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconHttpRequest}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="转换数据报文">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="转为 GET（参数移到URL）" Click="ChangeRequestFormatC" Tag="GET" >
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="转为 POST（表单urlencoded）" Click="ChangeRequestFormatC" Tag="POST_FORM" >
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="转为 POST（JSON）" Click="ChangeRequestFormatC" Tag="POST_JSON" >
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="转为 POST（multipart复杂格式）" Click="ChangeRequestFormatC" Tag="POST_MULTIPART" >
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                        <MenuItem Header="插入动态值">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconRandFlag}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="二次注入（单选）">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="发送请求" Command="{Binding SendRequestCommand}" CommandParameter="detect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconSendStroked}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="复制报文" Click="CopyRequestC">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="自动换行" Click="ToggleWrapC">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="清空报文" Click="ClearRequestC">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </AvaloniaEditor:TextEditor.ContextMenu>
                                            </AvaloniaEditor:TextEditor>
                                            <!--  子页3：跳过参数（jumpkey.txt；伴随请求子页仅数据操作页提供）  -->
                                            <Grid IsVisible="{Binding RequestSubTab3Visible}" RowDefinitions="Auto,*,Auto" Background="{DynamicResource DsgCard}">
                                                <Border Classes="subhead" Grid.Row="0">
                                                    <TextBlock Text="注入检测时命中下列参数名（不区分大小写）直接跳过，用于静态参数/Token/视图状态类参数降噪；增删即时生效并保存到 config/injection/jumpkey.txt" Classes="Secondary" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Border>
                                                <ListBox Grid.Row="1" Name="JumpkeyListBox" Margin="12,8"
                                                         SelectionMode="Multiple"
                                                         BorderThickness="1" BorderBrush="{DynamicResource DsgBorder}" CornerRadius="4"
                                                         ItemsSource="{Binding JumpkeyItems}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="删 除" Click="RemoveJumpkeySelect">
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </ListBox.ContextFlyout>
                                                </ListBox>
                                                <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="参数名：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="320" Classes="Bordered" Text="{Binding NewJumpkey}" VerticalAlignment="Center"
                                                                 PlaceholderText="如 __VIEWSTATE、csrf_token、submit" />
                                                        <u:IconButton Theme="{StaticResource SolidIconButton}" Classes="opadd tbtn"
                                                                      Icon="{StaticResource SemiIconPlusStroked}"
                                                                      Content="添加" Command="{Binding AddJumpkeyCommand}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!--  右侧工具列（可折叠：展开288px/收起30px展开条）  -->
                                <Grid Grid.Column="1">
                                <ScrollViewer Width="{Binding OverviewPanelWidth}" Background="{DynamicResource DsgCard}" VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding !OverviewCollapsed}">
                                    <StackPanel>
                                        <!--  检测概览  -->
                                        <Border>
                                            <StackPanel>
                                                <Grid Margin="10,5,0,4" ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="toolshead" Text="检测概览" VerticalAlignment="Center" />
                                                    <Button Classes="minibtn" Grid.Column="1" HorizontalAlignment="Right" Height="20" Padding="6,0" VerticalAlignment="Center"
                                                            Command="{Binding ToggleOverviewCommand}" ToolTip.Tip="收起检测概览（报文区加宽）">
                                                        <TextBlock Text="›" FontSize="12" VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="目标主机" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding AppConfig.Host}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="端口" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding OverviewPortText}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="注入参数" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding AppConfig.DataConfig.InjectParamName}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="注入位置" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding OverviewPlaceText}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="注入点" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding OverviewRecordCount}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="数据库" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding OverviewDBType}" />
                                                    </Grid>
                                                </Border>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}" Padding="10,5,10,10">
                                                    <StackPanel>
                                                        <TextBlock Classes="kvkey" Text="支持注入类型" Margin="0,5" />
                                                        <ItemsControl ItemsSource="{Binding InjectTypeTags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Classes="dtpath" Height="22">
                                                                        <TextBlock Text="{Binding}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="待检测" Classes="kvkey" FontStyle="Italic"
                                                                   IsVisible="{Binding !HasInjectRecords}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Classes="kvkey" Text="命中Payload" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" MaxWidth="168" TextTrimming="CharacterEllipsis"
                                                                   FontFamily="{StaticResource CodeFontFamily}" FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding OverviewPayloadText}" ToolTip.Tip="{Binding OverviewPayloadText}" />
                                                    </Grid>
                                                </Border>
                                                 <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto" Height="30">
                                                        <TextBlock Classes="kvkey" Text="最近命中" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding OverviewLastTimeText}" VerticalAlignment="Center" />
                                                    </Grid>
                                                 </Border>

                                                <Border Classes="kvrow">
                                                <Grid ColumnDefinitions="*,Auto" Height="30">
                                                    <TextBlock Classes="kvkey" Text="联合查询" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Classes="kvval" Text="{Binding AppConfig.DataConfig.SumColumnCount}" />
                                                        <TextBlock Classes="kvkey" Text="列 · 显示列" />
                                                        <TextBlock Classes="kvval" Text="{Binding AppConfig.DataConfig.ShowColumnIndex}" />
                                                    </StackPanel>
                                                </Grid>
                                                </Border>

                                                <Border Classes="kvrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="kvkey" Text="报错方式" />
                                                        <TextBlock Classes="kvval" Grid.Column="1" Text="{Binding AppConfig.DataConfig.SelectedErrorMethod}" />
                                                    </Grid>
                                                </Border>
                                                  <Border Classes="kvrow">
                                                <Grid ColumnDefinitions="*,Auto" Height="30" Classes="kvrow">
                                                    <TextBlock Classes="kvkey" Text="布尔盲注" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Classes="kvval" Text="{Binding AppConfig.DataConfig.SelectBoolInject}" />
                                                        <TextBlock Classes="kvkey" Text="· 判断值" />
                                                        <TextBlock Classes="kvval" Text="{Binding AppConfig.DataConfig.CheckValue}" />
                                                        <TextBlock Classes="kvkey" Text="反取" IsVisible="{Binding AppConfig.DataConfig.Reverse}" />
                                                    </StackPanel>
                                                </Grid>
                                                </Border>
                                                <Border Classes="kvrow">
                                                <Grid ColumnDefinitions="*,Auto" Height="30">
                                                    <TextBlock Classes="kvkey" Text="状态" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding DetectStatusBrush}" />
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DetectStatusText}"
                                                                   Foreground="{Binding DetectStatusBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                 </Border>
                                                <Border Classes="kvrow" VerticalAlignment="Center">
                                               
                                                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding AppConfig.RuningInfo.Progress}"/>
                                                </Border>
                                                
                                            </StackPanel>
                                        </Border>

                                        <!--  注入操作（与概览之间1px分隔线）  -->
                                        <Border Padding="12,11" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                                    <Button Grid.Row="0" Grid.Column="0" Classes="minibtn" Height="34" CornerRadius="4" Margin="0,0,4,0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding AppConfig.DataDump.StartGetDataBaseCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconDataBase}" Width="14" Height="14" />
                                                            <TextBlock Text="获取库表" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Row="0" Grid.Column="1" Classes="minibtn" Height="34" CornerRadius="4" Margin="4,0,0,0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding SelectNavCommand}" CommandParameter="4.7">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconReadData}" Width="14" Height="14" />
                                                            <TextBlock Text="读取数据" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="0" Classes="minibtn" Height="34" CornerRadius="4" Margin="0,8,4,0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding SelectNavCommand}" CommandParameter="2.1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconReadFile}" Width="14" Height="14" />
                                                            <TextBlock Text="读取文件" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Row="1" Grid.Column="1" Classes="minibtn" Height="34" CornerRadius="4" Margin="4,8,0,0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding SelectNavCommand}" CommandParameter="2.2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconCommand}" Width="14" Height="14" />
                                                            <TextBlock Text="命令执行" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Button Classes="minibtn" Height="34" CornerRadius="4"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                        Command="{Binding SelectNavCommand}" CommandParameter="2.0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource IconVerInfo}" Width="14" Height="14" />
                                                        <TextBlock Text="环境变量" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                                <!--  收起态：30px展开条  -->
                                <Border Width="30" IsVisible="{Binding OverviewCollapsed}" Background="{DynamicResource DsgCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Button Classes="minibtn" Height="22" Padding="4,0" Margin="0,6,0,0"
                                                Command="{Binding ToggleOverviewCommand}" ToolTip.Tip="展开检测概览">
                                            <TextBlock Text="‹" FontSize="12" VerticalAlignment="Center" />
                                        </Button>
                                        <TextBlock Text="检测概览" FontSize="11" Foreground="{DynamicResource DsgInk3}"
                                                   HorizontalAlignment="Center" Margin="14,10,0,0">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!--  ======== P3 注入记录 ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage3Visible}">
                            <Grid RowDefinitions="Auto,*">
                                <!--  工具栏：左侧操作按钮（带图标），右侧搜索/筛选  -->
                                <Border Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                         
                                            <u:IconButton Icon="{StaticResource IconEnterData}" Content="进入数据操作" VerticalAlignment="Center" Classes="tbtn"
                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding EnterDataOpCommand}"
                                                          ToolTip.Tip="恢复选中/勾选记录并跳转到数据操作页取数（勾选多行时取第一条）" />
                                            <u:IconButton Icon="{StaticResource SemiIconDeleteStroked}" Content="删除选中" VerticalAlignment="Center" Classes="opdel tbtn"
                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding RemoveCheckedInjectRecordsCommand}"
                                                          ToolTip.Tip="弹窗确认后批量删除勾选行的注入记录" />
                                            <u:IconButton Icon="{StaticResource SemiIconDelete}" Content="清空全部" VerticalAlignment="Center" Classes="opdel tbtn"
                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding ClearInjectRecordsCommand}"
                                                          ToolTip.Tip="弹窗确认后清空全部注入记录（不可恢复）" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" ItemSpacing="14" LineSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="数据库：" Classes="Secondary" VerticalAlignment="Center" />
                                                <ComboBox Width="130" Height="30" VerticalAlignment="Center"
                                                          ItemsSource="{Binding InjectRecordDbFilters}"
                                                          SelectedItem="{Binding InjectRecordFilterDb}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="注入类型：" Classes="Secondary" VerticalAlignment="Center" />
                                                <ComboBox Width="150" Height="30" VerticalAlignment="Center"
                                                          ItemsSource="{Binding InjectRecordTypeFilters}"
                                                          SelectedItem="{Binding InjectRecordFilterType}" />
                                            </StackPanel>
                                            <TextBlock Classes="Secondary" VerticalAlignment="Center" FontSize="10.5"
                                                       Text="{Binding InjectRecordCountInfo}" />
                                            <TextBox Width="280" Height="30" VerticalAlignment="Center"
                                                     Text="{Binding InjectRecordSearchKeyword}"
                                                     PlaceholderText="目标/参数/Payload 模糊搜索">
                                                <TextBox.InnerLeftContent>
                                                    <PathIcon Data="{StaticResource SemiIconSearchStroked}" Width="13" Height="13" Margin="8,0,0,0"
                                                              Foreground="{DynamicResource DsgInk3}" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <TableView Grid.Row="1" Name="InjectRecordTable" ItemsSource="{Binding FilteredInjectRecords}"
                                           SelectedItem="{Binding SelectedInjectRecord}"
                                           CanUserResizeColumns="True"
                                           BorderThickness="1">
                                    <TableView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="进入数据操作" Command="{Binding $parent[TableView].DataContext.EnterDataOpCommand}" >
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconReadData}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="-" />
                                            <MenuItem Header="设为当前注入上下文" Command="{Binding $parent[TableView].DataContext.RestoreInjectRecordCommand}" >
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource IconSqlInject}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="删除记录" Command="{Binding $parent[TableView].DataContext.RemoveInjectRecordCommand}" >
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </TableView.ContextMenu>
                                    <TableView.Columns>
                                        <TableViewColumn Header="选择" Width="46" HorizontalContentAlignment="Center">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:InjectRecord">
                                                    <CheckBox IsChecked="{Binding RowChecked}" Click="RowCheckSelectC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                        <TableViewColumn Header="时间" Binding="{Binding TimeStr}" Width="105" x:DataType="models:InjectRecord" />
                                        <TableViewColumn Header="目标" Binding="{Binding Target}" Width="2*" x:DataType="models:InjectRecord" />
                                        <TableViewColumn Header="参数" Binding="{Binding PName}" Width="90" x:DataType="models:InjectRecord" />
                                        <TableViewColumn Header="数据库" Width="105" x:DataType="models:InjectRecord" HorizontalContentAlignment="Left">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:InjectRecord">
                                                    <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                            Background="{DynamicResource DsgSurface3}">
                                                        <TextBlock Text="{Binding DBType}" FontSize="11" Foreground="{DynamicResource DsgInk2}" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                        <TableViewColumn Header="注入类型" Width="150" x:DataType="models:InjectRecord" HorizontalContentAlignment="Left">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:InjectRecord">
                                                    <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                            Background="{Binding InjectType, Converter={StaticResource InjectTypeBadgeConverter}, ConverterParameter=bg}">
                                                        <TextBlock Text="{Binding InjectTypeDesc}" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{Binding InjectType, Converter={StaticResource InjectTypeBadgeConverter}, ConverterParameter=fg}" />
                                                    </Border>
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                        <TableViewColumn Header="判断值" Binding="{Binding CheckValue}" Width="90" x:DataType="models:InjectRecord" />
                                        <TableViewColumn Header="列数" Binding="{Binding SumColumnCountText}" Width="55" x:DataType="models:InjectRecord" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Header="显示位" Binding="{Binding ShowColumnIndexText}" Width="60" x:DataType="models:InjectRecord" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Header="测试Payload" Binding="{Binding TestPayload}" Width="2*" x:DataType="models:InjectRecord" />
                                        <TableViewColumn Width="110" Header="操作" HorizontalContentAlignment="Center">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:InjectRecord">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <u:IconButton Width="26" Height="26" Padding="0"
                                                                      Theme="{DynamicResource BorderlessIconButton}"
                                                                      Icon="{StaticResource IconView}"
                                                                      Foreground="{DynamicResource DsgInk2}"
                                                                      Tag="{Binding}" Click="ViewInjectRecordRow"
                                                                      ToolTip.Tip="查看该注入记录详情" />
                                                        <u:IconButton Width="26" Height="26" Padding="0"
                                                                      Theme="{DynamicResource BorderlessIconButton}"
                                                                      Icon="{StaticResource IconEnterData}"
                                                                      Foreground="{DynamicResource DsgPrimary}"
                                                                      Tag="{Binding}" Click="EnterDataOpRow"
                                                                      ToolTip.Tip="恢复该记录并跳转到数据操作页取数" />
                                                        <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                      Theme="{DynamicResource BorderlessIconButton}"
                                                                      Icon="{StaticResource SemiIconDelete}"
                                                                      Tag="{Binding}" Click="DeleteInjectRecordRow"
                                                                      ToolTip.Tip="删除该注入记录（需确认）" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                    </TableView.Columns>
                                </TableView>
                            </Grid>
                        </Border>

                        <!--  ======== P4 数据操作（合并页：请求配置 + 注入操作 + 数据操作；注入记录选择已上移至顶部命令栏） ========  -->
                        <Border Classes="pageflat" Padding="0" IsVisible="{Binding NavPage4Visible}">
                            <Grid RowDefinitions="Auto,*">
                                <!--  注入配置条（检测记录选择/URL/端口/SSL + 取数增效开关两行；右侧“应用”通高按钮覆盖取数链路）  -->
                                <Border Grid.Row="0"
                                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}"
                                        Background="{DynamicResource DsgCard}" Padding="14,10">
                                    <!--  左右布局：左侧两行配置内容，右侧“应用”按钮通高对齐  -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                            <!--  第一行：注入记录选择 + 目标URL + 端口/SSL  -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                                                <TextBlock Text="检测记录" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" Width="300" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding InjectRecords}"
                                                          SelectedItem="{Binding QuickSelectRecord}"
                                                          PlaceholderText="选择注入记录，自动加载注入配置">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Column="2" Classes="kvkey" Text="目标URL：" Margin="14,0,0,0" />
                                                <TextBox Grid.Column="3" Classes="Bordered" Height="28"
                                                         Text="{Binding AppConfig.Url}"
                                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         FontFamily="{StaticResource CodeFontFamily}"
                                                         FontSize="12"
                                                         PlaceholderText="http://target/page?id=1" />
                                                <TextBlock Grid.Column="4" Classes="kvkey" Text="端口：" Margin="10,0,0,0" />
                                                <TextBox Grid.Column="5" Width="62" Height="28" Classes="Bordered" VerticalAlignment="Center" Text="{Binding AppConfig.Port}" />
                                                <CheckBox Grid.Column="6" Content="SSL" Margin="10,0,0,0" IsChecked="{Binding AppConfig.IsSSL}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Classes="kvkey" Text="线程：" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="8" Width="70" Height="28" Margin="6,0,0,0" ItemsSource="{Binding AppConfig.ThreadSizeItems}"
                                                          SelectedValue="{Binding AppConfig.ThreadSize}" VerticalAlignment="Center" />
                                            </Grid>
                                        <!--  第二行：取数增效开关（盲注链路）+ 字符集/读取方式  -->
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="值预测" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.PredictOutput}" VerticalAlignment="Center"
                                                              ToolTip.Tip="值预测：盲注读取库名/表名/列名/用户名等常见值时，按common-outputs字典同长候选做整值等值探测，命中即1次请求整串收工；猜错只多1次请求不会取错数据。仅盲注/时间通道生效" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="在线学习" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.NgramOnlineLearn}" VerticalAlignment="Center"
                                                              ToolTip.Tip="n-gram字符预测在线学习：成功读取的值（≤64字符纯ASCII）增量训练会话级trigram/bigram计数，按3倍权重合并进字符预测分布——同站点命名习惯越读越快；增量持久化到config/sessions/char_ngram_delta.json，删delta即恢复出厂；只影响分组权重不影响正确性，需开启值预测" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="值缓存" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.ValueCache}" VerticalAlignment="Center"
                                                              ToolTip.Tip="跨会话值缓存：结构类元数据取值（库/表/列/版本/用户等）持久化到config/sessions/value_cache.json，下次同注入点重读0请求直接命中；行数据不缓存防脏读；加载时日志提醒条数" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="缓存校验" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.ValueCacheVerify}" VerticalAlignment="Center"
                                                              ToolTip.Tip="值缓存新鲜度校验（默认开）：缓存命中后先发1次整值等值探测确认目标值未变化，目标库结构更新（加表/改名）时自动剔除陈旧值并重读更新；关闭则命中即返回（0请求，可能读到旧值）" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="通道升级" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.ChannelUpgrade}" VerticalAlignment="Center"
                                                              ToolTip.Tip="盲注/时间通道取数前自动探测同参数的Union/报错通道（来自注入记录），可用则本次读取走快通道，数量级提速；探测每注入点会话只进行一次，失败自动回退盲注" />
                                            </StackPanel>
                                            <Border Width="1" Background="{DynamicResource DsgBorder}" Margin="4,2" />
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="读取方式" Classes="Secondary" VerticalAlignment="Center" />
                                                <ComboBox Width="108" Height="26" VerticalAlignment="Center"
                                                          ItemsSource="{Binding AppConfig.DataConfig.BlindReadModes}"
                                                          SelectedItem="{Binding AppConfig.DataConfig.BlindReadMode}"
                                                          ToolTip.Tip="自动=按库选最快方案（MySQL系ord/PG·SQLite等码点/其余hex）；Ord打包值=强制MySQL ord路径；Hex编码=强制hex多字节安全兜底" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="编码" Classes="Secondary" VerticalAlignment="Center" />
                                                <ComboBox Width="88" Height="26" ItemsSource="{Binding AppConfig.PageEncodings}"
                                                          SelectedValue="{Binding AppConfig.DataConfig.DbEncoding}" VerticalAlignment="Center"
                                                          ToolTip.Tip="取数结果解码编码（DbEncoding），区别于网络设置的网页解码（响应自动识别）" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="中文识别" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.HexDecode}" VerticalAlignment="Center"
                                                              ToolTip.Tip="中文识别：开启后Union/报错通道取值统一HEX(CAST)包装，回显纯ASCII，按【编码】（DbEncoding）解码还原，中文等多字节数据不乱码；盲注通道默认已多字节安全，不受影响" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="NoCast" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataDump.DumpNoCast}" VerticalAlignment="Center"
                                                              ToolTip.Tip="NoCast：取数列不做cast/convert类型转换包装，避免特殊环境类型转换失败" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="读前清空" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataDump.ClearLastData}" VerticalAlignment="Center"
                                                              ToolTip.Tip="开始读取表数据前清空上次的结果列表" />
                                            </StackPanel>
                                        </StackPanel>
                                        </StackPanel>
                                        <!--  右侧：应用按钮通高对齐两行配置内容  -->
                                        <Button Grid.Column="1" Classes="Accent" Theme="{DynamicResource SolidButton}" Padding="5"
                                                Margin="10,0,0,0" VerticalAlignment="Stretch"
                                                Command="{Binding ApplyContextOverrideCommand}"
                                                ToolTip.Tip="选择注入记录自动带出配置，手工调整后点这里应用覆盖取数链路">保存</Button>
                                    </Grid>
                                </Border>

                                <!--  选项卡：请求配置 / 环境变量 / 读取文件 / 命令执行 / 数据操作  -->
                                <TabControl Grid.Row="1" BorderThickness="0" Padding="6,0,0,0" SelectedIndex="{Binding DataOpTabIndex}">
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgGlobe}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="请求配置" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid ColumnDefinitions="*,5,380" Margin="0,6,0,0">
                                                <!--  通道配置区（右侧：基础/Union/报错/盲注判断参数，随注入记录带出，手工调整后点顶部“应用”生效）  -->
                                                <Border Grid.Column="2">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Height="38" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <Path Classes="luc" Data="{StaticResource LgDatabaseZap}" Width="13.5" Height="13.5"
                                                                      Stroke="{DynamicResource DsgPrimary}" />
                                                                <TextBlock Text="通道配置" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <StackPanel Spacing="10" Margin="10,10">
                                                                <!--  基础通道配置  -->
                                                                <GroupBox Classes="chgrp" Header="基础">
                                                                    <Grid ColumnDefinitions="64,*,64,*">
                                                                        <TextBlock Classes="kvkey" Text="注入类型：" VerticalAlignment="Center" />
                                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AppConfig.DataConfig.InjectTypes}"
                                                                                  SelectedItem="{Binding CurrentContext.InjectType}" VerticalAlignment="Center">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource InjectTypeNameConverter}}" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                        <TextBlock Grid.Column="2" Classes="kvkey" Text="数据库：" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding AppConfig.DataConfig.DBTypes}"
                                                                                  SelectedItem="{Binding CurrentContext.DbType}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </GroupBox>
                                                                <!--  Union 通道参数  -->
                                                                <GroupBox Classes="chgrp" Header="Union">
                                                                    <Grid ColumnDefinitions="64,*,64,*">
                                                                        <TextBlock Classes="kvkey" Text="列数：" VerticalAlignment="Center" />
                                                                        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="60" Increment="1"
                                                                                       Value="{Binding CurrentContext.SumColumnCount}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Classes="kvkey" Text="显示列：" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                        <NumericUpDown Grid.Column="3" Minimum="1" Maximum="60" Increment="1"
                                                                                       Value="{Binding CurrentContext.ShowColumnIndex}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </GroupBox>
                                                                <!--  报错通道参数（无报错通道的库自动隐藏）  -->
                                                                <GroupBox Classes="chgrp" Header="报错" IsVisible="{Binding AppConfig.DataConfig.ErrorChannelVisible}">
                                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AppConfig.DataConfig.ErrorMethods}"
                                                                              SelectedItem="{Binding AppConfig.DataConfig.SelectedErrorMethod}" VerticalAlignment="Center" />
                                                                </GroupBox>
                                                                <!--  Bool盲注判断参数  -->
                                                                <GroupBox Classes="chgrp" Header="Bool盲注">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="64,*,Auto">
                                                                            <TextBlock Classes="kvkey" Text="类型：" VerticalAlignment="Center" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AppConfig.DataConfig.BoolInjectTypes}"
                                                                                      SelectedValue="{Binding AppConfig.DataConfig.SelectBoolInject}" VerticalAlignment="Center">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding Converter={StaticResource InjectTypeNameConverter}}" />
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <CheckBox Grid.Column="2" Content="反取值" IsChecked="{Binding AppConfig.DataConfig.Reverse}"
                                                                                      Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <Grid ColumnDefinitions="64,*">
                                                                            <TextBlock Classes="kvkey" Text="判断数据：" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0"
                                                                                     Text="{Binding AppConfig.DataConfig.CheckValue}" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </GroupBox>
                                                                <!--  时间盲注参数（延时秒数=取数sleep时长与响应耗时判定阈值；时间通道下改动实时生效）  -->
                                                                <GroupBox Classes="chgrp" Header="时间盲注">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="64,*">
                                                                            <TextBlock Classes="kvkey" Text="延时秒数：" VerticalAlignment="Center" />
                                                                            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="30" Increment="1"
                                                                                           Value="{Binding AppConfig.SleepInjectMaxTime}" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap"
                                                                                   Text="延时秒数同时作为取数sleep时长与响应耗时判定阈值；时间通道注入点下修改实时生效。" />
                                                                    </StackPanel>
                                                                </GroupBox>
                                                                <!--  判断值操作（卡片底部统一入口，服务于Bool盲注等判断通道；设置项与操作按钮分隔线分组）  -->
                                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                                                    <CheckBox Content="跟随302" IsChecked="{Binding AppConfig.FollowRedirect}" VerticalAlignment="Center" MinHeight="28" />
                                                                    <Border Width="1" Height="16" VerticalAlignment="Center" Background="{DynamicResource DsgBorder}" />
                                                                    <Button Classes="minibtn" Height="28" Command="{Binding AutoFindKeyCommand}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Path Classes="luc" Data="{StaticResource LgSearch}" />
                                                                            <TextBlock Text="查找判断值" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Classes="minibtn" Height="28" Command="{Binding CheckKeyCommand}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Path Classes="luc" Data="{StaticResource LgCircleCheck}" />
                                                                            <TextBlock Text="验证值" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </Border>
                                                <!--  中间分割条（1px分隔线+5px透明拖拽热区）  -->
                                                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                                                        Background="{DynamicResource DsgBorder}" />
                                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                                              Background="Transparent" />
                                                <!--  请求报文区（左侧，与注入检测页共享同一报文文档，标记/发送功能一致；只有一个子页，去掉选项卡条）  -->
                                                <Border Grid.Column="0">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Bottom" Height="44" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                                            <Grid Margin="10,0" ColumnDefinitions="Auto,*,Auto">
                                                                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                                                    <Button Classes="minibtn" Height="28" Click="SetEncodingPointC">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Path Classes="luc" Data="{StaticResource LgCode}" />
                                                                            <TextBlock Text="编码标记" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Classes="minibtn" Height="28" Click="SetInjectPointC">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Path Classes="luc" Data="{StaticResource LgCrosshair}" />
                                                                            <TextBlock Text="注入标记" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Name="DynFlyoutBtn" Classes="minibtn" Height="28">
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Opening="DynFlyoutOpeningC" />
                                                                        </Button.Flyout>
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Path Classes="luc" Data="{StaticResource LgSparkles}" />
                                                                            <TextBlock Text="动态值" VerticalAlignment="Center" ToolTip.Tip="插入动态值标记：点击规则启用它并把&lt;DRule&gt;标记插入报文光标处（有选区为&lt;DRule&gt;标记名:选区数据&lt;DRule&gt;，无选区为&lt;DRule&gt;标记名&lt;DRule&gt;），完整管理在 防护绕过-动态规则 页" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <u:IconButton Height="28" FontSize="12"
                                                                                  Icon="{StaticResource SemiIconSendStroked}"
                                                                                  Theme="{DynamicResource SolidIconButton}"
                                                                                  Content="发送请求" Command="{Binding SendRequestCommand}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="11" FontFamily="{StaticResource CodeFontFamily}"
                                                                           Foreground="{Binding RequestFootBrush}"
                                                                           Text="{Binding RequestFootText}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" FontSize="11" FontFamily="{StaticResource CodeFontFamily}"
                                                                           Foreground="{DynamicResource DsgInk3}" VerticalAlignment="Center"
                                                                           Text="{Binding AppConfig.DataConfig.DbEncoding, StringFormat={}{0} · HTTP请求包}" />
                                                            </Grid>
                                                        </Border>
                                                        <Grid Background="{DynamicResource DsgCodeBg}">
                                                            <!--  请求报文编辑器（取数专用文档：注入记录恢复时载入标记报文，与检测页报文相互独立；单页无选项卡，始终可见）  -->
                                                            <AvaloniaEditor:TextEditor FontFamily="{StaticResource CodeFontFamily}"
                                                                                     Name="RequestTxtBox2"
                                                                                     ShowLineNumbers="True"
                                                                                     Document="{Binding AppConfig.TxtRequest}"
                                                                                     HorizontalScrollBarVisibility="Auto"
                                                                                     VerticalScrollBarVisibility="Visible"
                                                                                     Watermark="选择注入记录自动载入报文，或复制HTTP请求数据包">
                                                                <AvaloniaEditor:TextEditor.ContextMenu>
                                                                    <ContextMenu Opened="RequestMenuOpenedC">
                                                                        <MenuItem Header="根据URL生成请求包" Click="BuildRequestFromUrlC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconHttpRequest}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="转换数据报文">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                            </MenuItem.Icon>
                                                                            <MenuItem Header="转为 GET（参数移到URL）" Click="ChangeRequestFormatC" Tag="GET" >
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="转为 POST（表单urlencoded）" Click="ChangeRequestFormatC" Tag="POST_FORM" >
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="转为 POST（JSON）" Click="ChangeRequestFormatC" Tag="POST_JSON" >
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <MenuItem Header="转为 POST（multipart复杂格式）" Click="ChangeRequestFormatC" Tag="POST_MULTIPART" >
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                        </MenuItem>
                                                                        <MenuItem Header="编码标记" Click="SetEncodingPointC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconEncodingFlag}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="注入标记" Click="SetInjectPointC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconInjectFlag}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="插入动态值">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconRandFlag}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="二次注入（单选）">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="发送请求" Command="{Binding SendRequestCommand}" CommandParameter="exploit">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource SemiIconSendStroked}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator />
                                                                        <MenuItem Header="复制报文" Click="CopyRequestC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="自动换行" Click="ToggleWrapC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource IconChangeRequest}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="清空报文" Click="ClearRequestC">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </AvaloniaEditor:TextEditor.ContextMenu>
                                                            </AvaloniaEditor:TextEditor>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgScrollText}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="环境变量" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  环境变量区  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource IconVerInfo}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="环境变量" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconChecklistStroked}"
                                                                          Content="全选" Command="{Binding SelectVersAllCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconCheckboxTick}"
                                                                          Content="反选" Command="{Binding ReverseSelectVersCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconLoading}"
                                                                          Command="{Binding StartGetVersInfoCommand}"
                                                                          Content="读取环境变量" />
                                                                    <u:IconButton
                                                                          Classes="Danger"
                                                                          Icon="{StaticResource SemiIconStop}"
                                                                          Command="{Binding StopAllCommand}"
                                                                          Content="停止读取"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TableView Grid.Row="1"
                                                                   Name="VersDataGrid"
                                                                   CanUserResizeColumns="True"
                                                                   ItemsSource="{Binding AppConfig.DataConfig.VersItems}"
                                                                   BorderThickness="1"
                                                                   ScrollViewer.AllowAutoHide="True">
                                                            <TableView.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="获取环境变量值" Command="{Binding StartGetVersInfoCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconLoading}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="全选" Command="{Binding SelectVersAllCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconSelectAll}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="反选" Command="{Binding ReverseSelectVersCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconDeSelect}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="复制值" Click="CopyVersValueC">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </TableView.ContextFlyout>
                                                            <TableView.Columns>
                                                                <TableViewColumn Width="80" Header="选择" HorizontalContentAlignment="Center">
                                                                    <TableViewColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="models:VersModel">
                                                                            <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </DataTemplate>
                                                                    </TableViewColumn.CellTemplate>
                                                                </TableViewColumn>
                                                                <TableViewColumn Width="*" x:DataType="models:VersModel" Binding="{Binding Name}" Header="变量名" />
                                                                <TableViewColumn Width="4*" x:DataType="models:VersModel" Binding="{Binding VerPayload}" Header="Payload" />
                                                                <TableViewColumn Width="2*" x:DataType="models:VersModel" Binding="{Binding Value}" Header="变量值" />
                                                            </TableView.Columns>
                                                        </TableView>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgShieldAlert}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="Hash读取" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  Hash读取区（取数模板中Hash/DBA/sysadmin类条目自动分流到此）  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource IconBypassSafe}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="Hash读取" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                    <TextBlock Text="（全用户哈希/是否DBA等，随数据库类型自动加载）" Classes="Secondary" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconChecklistStroked}"
                                                                          Content="全选" Command="{Binding SelectHashAllCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconCheckboxTick}"
                                                                          Content="反选" Command="{Binding ReverseSelectHashCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconLoading}"
                                                                          Command="{Binding StartGetHashInfoCommand}"
                                                                          Content="读取Hash" />
                                                                    <u:IconButton
                                                                          Classes="Danger"
                                                                          Icon="{StaticResource SemiIconStop}"
                                                                          Command="{Binding StopAllCommand}"
                                                                          Content="停止读取" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TableView Grid.Row="1"
                                                                   Name="HashDataGrid"
                                                                   CanUserResizeColumns="True"
                                                                   ItemsSource="{Binding AppConfig.DataConfig.HashItems}"
                                                                   BorderThickness="1"
                                                                   ScrollViewer.AllowAutoHide="True">
                                                            <TableView.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="读取Hash值" Command="{Binding StartGetHashInfoCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconLoading}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="全选" Command="{Binding SelectHashAllCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconSelectAll}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="反选" Command="{Binding ReverseSelectHashCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconDeSelect}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="复制值" Click="CopyHashValueC">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </TableView.ContextFlyout>
                                                            <TableView.Columns>
                                                                <TableViewColumn Width="80" Header="选择" HorizontalContentAlignment="Center">
                                                                    <TableViewColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="models:VersModel">
                                                                            <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </DataTemplate>
                                                                    </TableViewColumn.CellTemplate>
                                                                </TableViewColumn>
                                                                <TableViewColumn Width="*" x:DataType="models:VersModel" Binding="{Binding Name}" Header="名称" />
                                                                <TableViewColumn Width="4*" x:DataType="models:VersModel" Binding="{Binding VerPayload}" Header="Payload" />
                                                                <TableViewColumn Width="2*" x:DataType="models:VersModel" Binding="{Binding Value}" Header="值" />
                                                            </TableView.Columns>
                                                        </TableView>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgShieldAlert}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="权限角色" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  权限角色区（权限/角色查询：取数模板中权限/角色类条目自动分流到此）  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource IconBypassSafe}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="权限角色" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                    <TextBlock Text="（当前用户权限/角色成员/会话权限等，随数据库类型自动加载）" Classes="Secondary" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconChecklistStroked}"
                                                                          Content="全选" Command="{Binding SelectPrivAllCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconCheckboxTick}"
                                                                          Content="反选" Command="{Binding ReverseSelectPrivCommand}" Theme="{DynamicResource OutlineIconButton}" />
                                                                    <u:IconButton
                                                                          Icon="{StaticResource SemiIconLoading}"
                                                                          Command="{Binding StartGetPrivInfoCommand}"
                                                                          Content="读取权限" />
                                                                    <u:IconButton
                                                                          Classes="Danger"
                                                                          Icon="{StaticResource SemiIconStop}"
                                                                          Command="{Binding StopAllCommand}"
                                                                          Content="停止读取" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TableView Grid.Row="1"
                                                                   Name="PrivDataGrid"
                                                                   CanUserResizeColumns="True"
                                                                   ItemsSource="{Binding AppConfig.DataConfig.PrivItems}"
                                                                   BorderThickness="1"
                                                                   ScrollViewer.AllowAutoHide="True">
                                                            <TableView.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="读取权限角色" Command="{Binding StartGetPrivInfoCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconLoading}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="全选" Command="{Binding SelectPrivAllCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconSelectAll}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="反选" Command="{Binding ReverseSelectPrivCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource IconDeSelect}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="复制值" Click="CopyPrivValueC">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </TableView.ContextFlyout>
                                                            <TableView.Columns>
                                                                <TableViewColumn Width="80" Header="选择" HorizontalContentAlignment="Center">
                                                                    <TableViewColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="models:VersModel">
                                                                            <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </DataTemplate>
                                                                    </TableViewColumn.CellTemplate>
                                                                </TableViewColumn>
                                                                <TableViewColumn Width="*" x:DataType="models:VersModel" Binding="{Binding Name}" Header="名称" />
                                                                <TableViewColumn Width="4*" x:DataType="models:VersModel" Binding="{Binding VerPayload}" Header="Payload" />
                                                                <TableViewColumn Width="2*" x:DataType="models:VersModel" Binding="{Binding Value}" Header="值" />
                                                            </TableView.Columns>
                                                        </TableView>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgBinary}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="读取文件" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  读取文件区  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <WrapPanel ItemSpacing="10" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <PathIcon Data="{StaticResource IconReadFile}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="读取文件" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="文件路径：" Classes="Secondary" VerticalAlignment="Center" />
                                                                <TextBox Width="220" VerticalAlignment="Center" Text="{Binding AppConfig.FileCmd.FilePath}" />
                                                                <TextBlock Text="文件编码：" Classes="Secondary" VerticalAlignment="Center" />
                                                                <u:AutoCompleteBox Width="140"
                                                                       
                                                                       PlaceholderText="文件编码"
                                                                       Text="{Binding AppConfig.FileCmd.FileEncoding}"
                                                                       Classes="ClearButton"
                                                                       ItemsSource="{Binding AppConfig.PageEncodings}" />
                                                                <TextBlock Text="操作方式：" VerticalAlignment="Center" />
                                                                <ComboBox Width="170" VerticalAlignment="Center"
                                                                          ItemsSource="{Binding AppConfig.FileCmd.FileMethods}"
                                                                          PlaceholderText="选择操作方式"
                                                                          SelectedItem="{Binding AppConfig.FileCmd.SelectedFileMethod}" />
                                                               
                                                                <u:IconButton
                                                                      Theme="{StaticResource SolidIconButton}"
                                                                      Icon="{StaticResource SemiIconPlay}"
                                                                      Command="{Binding AppConfig.FileCmd.StartFileOperateCommand}"
                                                                      Content="执行" />
                                                                <TextBlock Text="{Binding AppConfig.FileCmd.FileMethodHint}" Foreground="{DynamicResource DsgWarning}" VerticalAlignment="Center" /> 
                                                            </WrapPanel>
                                                        </Border>
                                                        <TextBox
                                                                    Grid.Row="1"
                                                                    Margin="12,10"
                                                                    AcceptsReturn="True"
                                                                    HorizontalAlignment="Stretch"
                                                                    TextWrapping="Wrap"
                                                                    Classes="TextArea"
                                                                    Text="{Binding AppConfig.FileCmd.FileContent}"
                                                                    VerticalAlignment="Stretch"
                                                                    VerticalContentAlignment="Top"
                                                                    PlaceholderText="文件内容显示区（写文件时在此输入要写入的内容）" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgTerminal}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="命令执行" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  命令执行区  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <WrapPanel ItemSpacing="10" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <PathIcon Data="{StaticResource IconCommand}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="命令执行" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="命令：" Classes="Secondary" VerticalAlignment="Center" />
                                                                <TextBox Width="300" VerticalAlignment="Center" Text="{Binding AppConfig.FileCmd.CmdText}"
                                                                          />
                                                                <CheckBox Content="回显结果" IsChecked="{Binding AppConfig.FileCmd.CmdShowResult}" VerticalAlignment="Center"
                                                                           />
                                                                <CheckBox Content="会话模式" IsChecked="{Binding AppConfig.FileCmd.CmdSessionMode}" VerticalAlignment="Center"
                                                                          
                                                                          ToolTip.Tip="会话模式：命令与回显按历史追加显示，UDF/xp_cmdshell通道保持复用" />
                                                                 <TextBlock Text="方式：" Classes="Secondary" VerticalAlignment="Center" />
                                                                  <ComboBox Width="170" Height="28" VerticalAlignment="Center"
                                                                          ItemsSource="{Binding AppConfig.FileCmd.CmdMethods}"
                                                                          SelectedItem="{Binding AppConfig.FileCmd.SelectedCmdMethod}" />
                                                                <u:IconButton
                                                                      Theme="{StaticResource SolidIconButton}"
                                                                      Icon="{StaticResource SemiIconPlay}"
                                                                      IsEnabled="{Binding AppConfig.FileCmd.CmdSupported}"
                                                                      Command="{Binding AppConfig.FileCmd.StartExecCmdCommand}"
                                                                      Content="执行" />
                                                                <u:IconButton
                                                                      Theme="{StaticResource OutlineIconButton}"
                                                                      Icon="{StaticResource SemiIconDelete}"
                                                                      Command="{Binding AppConfig.FileCmd.ClearCmdSessionCommand}"
                                                                      Content="清空会话"
                                                                      ToolTip.Tip="清空命令会话历史回显" />
                                                                <u:IconButton
                                                                      Theme="{StaticResource OutlineIconButton}"
                                                                      Classes="Danger"
                                                                      Icon="{StaticResource SemiIconDelete}"
                                                                      Command="{Binding AppConfig.FileCmd.CleanupUdfCommand}"
                                                                      Content="清理UDF"
                                                                      ToolTip.Tip="UDF痕迹清理：删除UDF库文件并drop sys_eval/sys_exec函数（支持MySQL/PostgreSQL UDF通道）" />
                                                               
                                                                <WrapPanel>
                                                                    <TextBlock Text="提示信息：" Classes="Secondary" VerticalAlignment="Center" />
                                                                     <TextBlock Text="{Binding AppConfig.FileCmd.CmdMethodHint}" Classes="Secondary" VerticalAlignment="Center" />
                                                                </WrapPanel>
                                                               
                                                            </WrapPanel>
                                                        </Border>
                                                        <TextBox
                                                                    Grid.Row="1"
                                                                    Margin="12,10"
                                                                    AcceptsReturn="True"
                                                                    IsReadOnly="True"
                                                                    HorizontalAlignment="Stretch"
                                                                    TextWrapping="Wrap"
                                                                    Classes="TextArea"
                                                                    Text="{Binding AppConfig.FileCmd.CmdResult}"
                                                                    VerticalAlignment="Stretch"
                                                                    VerticalContentAlignment="Top"
                                                                    PlaceholderText="命令执行结果显示区（会话模式下按 > 命令 + 回显 追加历史）" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgDatabaseZap}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="自定义SQL" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*">
                                                <!--  自定义SQL执行区（任意SQL语句注入执行）  -->
                                                <Border Grid.Row="0">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                            <WrapPanel ItemSpacing="10" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <Path Classes="luc" Data="{StaticResource LgDatabaseZap}" Width="14" Height="14" Stroke="{DynamicResource DsgPrimary}" />
                                                                    <TextBlock Text="自定义SQL" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="SQL：" Classes="Secondary" VerticalAlignment="Center" />
                                                                <TextBox Width="500" VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.CustomSql}"
                                                                         PlaceholderText="需返回单行单列，如 select user / select version" />
                                                                <u:IconButton
                                                                      Theme="{StaticResource SolidIconButton}"
                                                                      Icon="{StaticResource SemiIconPlay}"
                                                                      Command="{Binding AppConfig.DataDump.ExecCustomSqlCommand}"
                                                                      Content="执行" />
                                                                <TextBlock Text="按当前注入通道执行（Union/报错/盲注/堆叠自动适配）" Classes="Secondary" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                        </Border>
                                                        <TextBox
                                                                    Grid.Row="1"
                                                                    Margin="12,10"
                                                                    AcceptsReturn="True"
                                                                    HorizontalAlignment="Stretch"
                                                                    TextWrapping="Wrap"
                                                                    Classes="TextArea"
                                                                    Text="{Binding AppConfig.DataDump.CustomSqlResult}"
                                                                    VerticalAlignment="Stretch"
                                                                    VerticalContentAlignment="Top"
                                                                    PlaceholderText="SQL执行结果显示区" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgTable2}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="数据操作" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <TabItem.Content>
                                            <Grid RowDefinitions="*,Auto">
                                <!--  工作区：左树右表  -->
                                <Grid ColumnDefinitions="300, Auto, *" Grid.Row="0">
                                    <Border Grid.Column="0" Padding="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DsgBorder}">
                                        <Grid RowDefinitions="Auto,Auto,*">
                                            <Border Classes="subhead" Grid.Row="0" Height="44">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Classes="toolshead" Text="库结构" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="字典猜解" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.DataConfig.DictGuessAll}" VerticalAlignment="Center"
                                                                      ToolTip.Tip="字典猜解：获取表/字段走exists布尔字典猜解（common_tables/common_columns字典），用于元数据不可读的低权限点；Access默认启用" />
                                                        <Button Classes="minibtn" Height="20" Command="{Binding AppConfig.DataDump.AddDBStructNodeCommand}">添加库</Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!--  搜索区：本地搜索（树内标红）+ 服务端搜索（SQL过滤取数）  -->
                                            <Border Grid.Row="1" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="64,*,Auto,Auto">
                                                        <ComboBox Grid.Column="0" Height="24" VerticalContentAlignment="Center" SelectedIndex="{Binding AppConfig.DataDump.SearchTypeIndex}">
                                                            <ComboBoxItem>库</ComboBoxItem>
                                                            <ComboBoxItem>表</ComboBoxItem>
                                                            <ComboBoxItem>列</ComboBoxItem>
                                                        </ComboBox>
                                                        <TextBox Grid.Column="1" Margin="4,0,0,0" Height="24" VerticalContentAlignment="Center" Text="{Binding AppConfig.DataDump.SearchKeyword}" PlaceholderText="搜索关键词" />
                                                        <Button Grid.Column="2" Classes="minibtn" Height="22" Margin="4,0,0,0" Command="{Binding AppConfig.DataDump.LocalSearchCommand}" ToolTip.Tip="在已加载的树节点中搜索，命中节点标红">本地</Button>
                                                        <Button Grid.Column="3" Classes="minibtn" Height="22" Margin="4,0,0,0" Command="{Binding AppConfig.DataDump.ServerSearchCommand}" ToolTip.Tip="通过SQL在数据库中LIKE过滤搜索，结果自动挂到树并标红">服务端</Button>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AppConfig.DataDump.SearchResultInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Grid.Column="0" FontSize="11" Opacity="0.75" VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.SearchResultInfo}" />
                                                        <Button Grid.Column="1" Classes="minibtn" Height="20" Command="{Binding AppConfig.DataDump.ClearSearchCommand}" ToolTip.Tip="清空搜索高亮">清除</Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        <TreeView Grid.Row="2" Padding="4,6" Name="DBStructTree" SelectionMode="Multiple" ItemsSource="{Binding AppConfig.DataDump.DBStructItems}">
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="True" />
                                                </Style>
                                            </TreeView.Styles>
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate ItemsSource="{Binding SubItems}">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <CheckBox VerticalAlignment="Center" HorizontalAlignment="Left" IsChecked="{Binding IsSelected}" />
                                                        <PathIcon>
                                                            <PathIcon.Data>
                                                                <MultiBinding Converter="{StaticResource TreeViewIconConverter}">
                                                                    <Binding Path="Type" />
                                                                    <Binding Path="IsExpanded" />
                                                                </MultiBinding>
                                                            </PathIcon.Data>
                                                        </PathIcon>
                                                        <TextBlock Text="{Binding Value}" Background="{Binding SearchHitBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !IsEdit}" />
                                                        <TextBox Text="{Binding Value}" MinWidth="100" VerticalAlignment="Center" IsVisible="{Binding IsEdit}" LostFocus="TreeNodeEditLostFocus" />
                                                    </StackPanel>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                            <TreeView.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="获取数据库" Command="{Binding AppConfig.DataDump.StartGetDataBaseCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconDataBase}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="获取表" Command="{Binding AppConfig.DataDump.StartGetDataTablesCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconTable}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="获取字段" Command="{Binding AppConfig.DataDump.StartGetDataColumnsCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconColumn}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="立即停止" Command="{Binding StopAllCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconStop}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="-" />
                                                    <MenuItem Header="添加数据库" Command="{Binding AppConfig.DataDump.AddDBStructNodeCommand}" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconDataBase}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="添加子节点" Click="AddSubTreeNodeC" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconTable}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="修改节点" Click="EditTreeNodeC" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconConfig}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="删除节点" Click="DeleteTreeNodeC" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="-" />
                                                    <MenuItem Header="全选子节点" Click="SelectAllSubNodeC" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconSelectAll}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="反选子节点" Click="ReverseSubNodeC" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconDeSelect}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="-" />
                                                    <MenuItem Header="保存库表列结构" Command="{Binding AppConfig.DataDump.SaveDBStructCommand}" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconExport}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="加载库表列结构" Command="{Binding AppConfig.DataDump.LoadDBStructCommand}" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconImport}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="清空所有结构" Command="{Binding AppConfig.DataDump.ClearDBStructCommand}" >
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </TreeView.ContextFlyout>
                                        </TreeView>
                                        </Grid>
                                    </Border>
                                    <GridSplitter Grid.Column="1" ShowsPreview="True" />
                                    <Border Grid.Column="2" Padding="0">
                                        <Grid RowDefinitions="Auto,*">
                                            <Border Classes="subhead" Grid.Row="0" Height="44">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Classes="toolshead" Text="表数据" VerticalAlignment="Center" />
                                                        <Border Classes="dtpath" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DumpPathText}" />
                                                        </Border>
                                                        <Border Classes="sbbadge">
                                                            <TextBlock Text="{Binding DumpColsText}" />
                                                        </Border>
                                                        <Border Classes="sbbadge">
                                                            <TextBlock Text="{Binding DumpRowsText}" />
                                                        </Border>
                                                        <TextBlock Classes="kvkey" Text="WHERE" VerticalAlignment="Center" />
                                                        <TextBox Width="400" Height="26" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding AppConfig.DataDump.DumpWhere}"
                                                                 PlaceholderText="行过滤，如 id>100" ToolTip.Tip="自定义WHERE行过滤（无需写where关键字），同步作用于总数统计与行数据取数SQL" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Classes="minibtn" Height="22" Click="CopyDumpRowsC">复制行</Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                    <TableView Grid.Row="1" Name="DynamicDataGrid"
                                                          ItemsSource="{Binding AppConfig.DataDump.Rows}"
                                                          helper:DataGridColumnBuilder.Columns="{Binding AppConfig.DataDump.Columns}"
                                                          CanUserResizeColumns="True"
                                                          BorderThickness="1"
                                                          ScrollViewer.AllowAutoHide="True">
                                        <TableView.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="复制选中行数据" Click="CopyDumpRowsC">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </TableView.ContextFlyout>
                                    </TableView>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <!--  参数工具条  -->
                                <Border Grid.Row="1" Height="46" Padding="12,0" Background="{DynamicResource DsgCard}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="minibtn" Height="26" Command="{Binding AppConfig.DataDump.StartGetDataBaseCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource IconDataBase}" Width="12" Height="12" />
                                                    <TextBlock Text="获 取 库" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="minibtn" Height="26" Command="{Binding AppConfig.DataDump.StartGetDataTablesCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource IconTable}" Width="12" Height="12" />
                                                    <TextBlock Text="获 取 表" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="minibtn" Height="26" Command="{Binding AppConfig.DataDump.StartGetDataColumnsCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource IconColumn}" Width="12" Height="12" />
                                                    <TextBlock Text="获取字段" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Border Classes="dtvsep" Margin="23,0" />
                                            <TextBlock Classes="kvkey" Text="开始下标" />
                                            <NumericUpDown Increment="1" Width="76" Height="28" 
                                                           Minimum="0" Value="{Binding AppConfig.DataDump.DataDumpStart}" VerticalAlignment="Center" />
                                            <TextBlock Classes="kvkey" Text="获取条数" />
                                            <NumericUpDown Increment="1" Width="76" Height="28" Value="{Binding AppConfig.DataDump.DumpCount}" 
                                                           Minimum="1" VerticalAlignment="Center" />
                                            <TextBlock Classes="kvkey" Text="Union批量" />
                                            <NumericUpDown Increment="1" Width="64" Height="28" Value="{Binding AppConfig.DataConfig.UnionBatchRows}"
                                                           Minimum="1" Maximum="50" VerticalAlignment="Center"
                                                           ToolTip.Tip="Union批量取数行数：>1时聚合函数多行拼单行一次回显（k行1次请求），截断/取空自动回退逐行；1=逐行" />
                                            <TextBlock Classes="kvkey" Text="总条数" />
                                            <Border Classes="dttotal">
                                                <TextBlock Text="{Binding AppConfig.DataDump.DataCount}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="Danger" Height="28" Padding="14,0" Command="{Binding StopAllCommand}">停止</Button>
                                            <Button Classes="Accent" Theme="{DynamicResource SolidButton}" Height="28" Padding="14,0" Command="{Binding AppConfig.DataDump.StartGetDataCommand}">开始读取</Button>
                                            <Button Classes="minibtn" Height="28" Padding="14,0" Command="{Binding AppConfig.DataDump.ExportDataCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource SemiIconDownloadStroked}" Width="12" Height="12" />
                                                    <TextBlock Text="导出" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                            </Grid>
                                        </TabItem.Content>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>

                        <!--  ======== P5 网络设置（基础配置 + HTTP认证/代理/DNSLog/UA池/字典/重发选项卡） ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage5Visible}">
                            <TabControl BorderThickness="0" Padding="6,0,0,0">
                                <!--  基础配置：HTTP基础请求参数（原页面顶部请求设置区迁入）  -->
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgGlobe}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="基础配置" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,Auto,*">
                                        <Border Classes="subhead" Grid.Row="0">
                                            <TextBlock Text="超时/重试/302跟随/连接池/网页解码等HTTP基础请求参数；随机源IP伪造X-Forwarded-For等客户端IP头，绕过基于源IP的访问控制与频率限制" Classes="Secondary" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Border>
                                        <GroupBox Grid.Row="1" Classes="chgrp" Header="请求设置" Margin="12,10,12,0">
                                            <Grid ColumnDefinitions="*">
                                                <WrapPanel ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="超时时间：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ComboBox Width="80" VerticalAlignment="Center" SelectedIndex="0" SelectedValue="{Binding AppConfig.TimeOut}" ItemsSource="{Binding AppConfig.TimeItems}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="超时重试：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ComboBox Width="80" VerticalAlignment="Center" SelectedIndex="0" SelectedValue="{Binding AppConfig.RetryCount}">
                                                            <ComboBoxItem>1</ComboBoxItem>
                                                            <ComboBoxItem>2</ComboBoxItem>
                                                            <ComboBoxItem>3</ComboBoxItem>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <CheckBox Content="跟踪302" IsChecked="{Binding AppConfig.FollowRedirect}" VerticalAlignment="Center" />
                                                    <CheckBox Content="随机源IP" IsChecked="{Binding AppConfig.ByPassConfig.RandomIpEnabled}" VerticalAlignment="Center"
                                                              ToolTip.Tip="每请求生成随机IPv4写入X-Forwarded-For / X-Real-IP / Client-IP头，绕过基于源IP的访问控制与频率限制" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="连接池：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <NumericUpDown Width="70" Height="28" Minimum="1" Maximum="10" Increment="1"
                                                                       Value="{Binding AppConfig.PoolSize}" VerticalAlignment="Center"
                                                                       ToolTip.Tip="HTTP连接池每主机最大连接数（1-10，默认5）：Keep-Alive复用省TCP+TLS握手；多线程盲注建议不小于线程数" />
                                                    </StackPanel>
                                                    <CheckBox Content="网页自动解码" IsChecked="{Binding AppConfig.AutoEncode}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="网页解码：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ComboBox Width="140"   Classes="ClearButton" ItemsSource="{Binding AppConfig.PageEncodings}" SelectedValue="{Binding AppConfig.PageEncoding}" IsEnabled="{Binding !AppConfig.AutoEncode}" ToolTip.Tip="自动解码开启时优先用响应头识别的编码（此时本项只读），识别不到时回落到此编码；关闭自动解码则固定使用此编码（可编辑）" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgLock}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="HTTP认证" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,Auto,*">
                                            <Border Classes="subhead" Grid.Row="0">
                                                <TextBlock Text="HTTP认证：Basic每次请求自动带认证头；Digest首次401挑战后自动重发并缓存挑战；NTLM为连接级握手（NTLMv1），认证连接自动复用" Classes="Secondary" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Border>
                                            <GroupBox Grid.Row="1" Classes="chgrp" Header="认证配置" Margin="12,10,12,0">
                                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                    <TextBlock Text="认证类型：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ComboBox Width="110" VerticalAlignment="Center" ItemsSource="{Binding AppConfig.AuthTypeItems}" SelectedItem="{Binding AppConfig.AuthTypeText}" />
                                                    <TextBlock Text="用户名：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="160" VerticalAlignment="Center" Text="{Binding AppConfig.AuthUser}" PlaceholderText="认证用户名" />
                                                    <TextBlock Text="密码：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="160" VerticalAlignment="Center" Text="{Binding AppConfig.AuthPass}" PlaceholderText="认证密码" PasswordChar="●" />
                                                    <TextBlock Text="域：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="180" VerticalAlignment="Center" Text="{Binding AppConfig.AuthDomain}" PlaceholderText="域(仅NTLM，可空)" />
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Grid.Row="2" Classes="chgrp" Header="说明" Margin="12,10,12,10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· Basic：Authorization头 preemptive 携带 Base64(用户名:密码)，适合已知凭据的站点；" />
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· Digest：无需预填挑战，首次请求收到401后自动完成挑战-响应并重发，后续请求 preemptive 携带（nc自动递增）；" />
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· NTLM：Type1/Type2/Type3 握手在同一连接上完成，认证通过的连接归还连接池复用，盲注高并发下不重复握手；" />
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 认证失败的请求表现为401状态码，注入检测的比对照会自然排除，无需额外处理。" />
                                                </StackPanel>
                                            </GroupBox>
                                        </Grid>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgServer}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="代理设置" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <Border Classes="subhead" Grid.Row="0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="通过代理转发请求，支持代理池轮换与可用性验证" Classes="Secondary" FontSize="11" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="启用代理" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.ProxyConfig.ProxyEnable}" VerticalAlignment="Center" />
                                                    <TextBlock Text="代理模式：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ComboBox Width="130" Height="26" ItemsSource="{Binding AppConfig.ProxyConfig.ProxyTypeItems}" SelectedItem="{Binding AppConfig.ProxyConfig.SelectProxyType}" VerticalAlignment="Center" />
                                                    <TextBlock Text="当前代理：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding AppConfig.ProxyConfig.CurrentProxyText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TableView Grid.Row="1"
                                                   CanUserResizeColumns="True"
                                                   Name="ProxyDataGrid"
                                                   ItemsSource="{Binding AppConfig.ProxyConfig.ProxyItems}"
                                                   BorderThickness="1"
                                                   ScrollViewer.AllowAutoHide="True">
                                                <TableView.Columns>
                                                    <TableViewColumn Width="*" x:DataType="models:Proxy" Binding="{Binding Host}" Header="主机" />
                                                    <TableViewColumn Width="*" x:DataType="models:Proxy" Binding="{Binding Port}" Header="端口" HorizontalContentAlignment="Center" />
                                                    <TableViewColumn Width="*" x:DataType="models:Proxy" Binding="{Binding proxyType}" Header="类型" HorizontalContentAlignment="Center" />
                                                    <TableViewColumn Header="是否启用" Width="*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:Proxy">
                                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="是否可用" Width="*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:Proxy">
                                                                <CheckBox IsChecked="{Binding IsOk, Mode=OneWay}" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Width="*" x:DataType="models:Proxy" Binding="{Binding UseTime}" Header="耗时(毫秒)" HorizontalContentAlignment="Center" />
                                                    <TableViewColumn Width="1.5*" x:DataType="models:Proxy" Binding="{Binding CheckTime}" Header="验证时间" />
                                                </TableView.Columns>
                                                <TableView.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="验证选中代理" Click="CheckProxySelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconCheckboxTick}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="验证所有代理" Command="{Binding CheckAllProxyCommand}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconCheckboxTick}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="导入代理" Command="{Binding ImportProxyCommand}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconImport}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="导出代理" Command="{Binding ExportProxyCommand}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconExport}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="删除选中" Click="RemoveProxySelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </TableView.ContextFlyout>
                                            </TableView>
                                            <Border Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}" Grid.Row="2">
                                                <WrapPanel ItemSpacing="10" Orientation="Horizontal">
                                                    <TextBlock Text="代理IP：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <u:IPv4Box  Width="200" IPAddress="{Binding AppConfig.ProxyConfig.AddProxy.IP}" InputMode="Fast" ShowLeadingZero="True" />
                                                    <TextBlock Text="端口：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="80" Classes="Bordered" Text="{Binding AppConfig.ProxyConfig.AddProxy.Port}" VerticalAlignment="Center" />
                                                    <TextBlock Text="类型：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ComboBox Width="100" SelectedItem="{Binding AppConfig.ProxyConfig.AddProxy.proxyType}" VerticalAlignment="Center">
                                                        <ComboBoxItem>Socks5</ComboBoxItem>
                                                        <ComboBoxItem>HTTP</ComboBoxItem>
                                                    </ComboBox>
                                                    <TextBlock Text="用户名：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="100" Classes="Bordered" Text="{Binding AppConfig.ProxyConfig.AddProxy.username}" VerticalAlignment="Center" />
                                                    <TextBlock Text="密码：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="100" Classes="Bordered" Text="{Binding AppConfig.ProxyConfig.AddProxy.password}" VerticalAlignment="Center" />
                                                    <u:IconButton
                                                          Theme="{StaticResource SolidIconButton}" Classes="opadd tbtn"
                                                          Icon="{StaticResource SemiIconPlusStroked}"
                                                          Content="添加代理" Command="{Binding AddProxyCommand}" />
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <!--  UA池：随机User-Agent轮换  -->
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgSignal}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="DNSLog" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,Auto,*">
                                            <Border Classes="subhead" Grid.Row="0">
                                                <TextBlock Text="DNS外带数据接收通道：盲注无回显场景把查询结果编码进DNS子域名外带；配置API后可自动回收解析记录" Classes="Secondary" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Border>
                                            <GroupBox Grid.Row="1" Classes="chgrp" Header="DNSLog 配置" Margin="12,10,12,0">
                                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="DNSLog域名：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="260" VerticalAlignment="Center" Text="{Binding AppConfig.DataConfig.DnsLogDomain}" PlaceholderText="DNS外带域名，如 abc.ceye.io" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="API Token：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="260" VerticalAlignment="Center" Text="{Binding AppConfig.DataConfig.DnsLogApiToken}" PlaceholderText="ceye API Token（配了自动回收结果）" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="API地址：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="420" VerticalAlignment="Center" Text="{Binding AppConfig.DataConfig.DnsLogApiUrl}" PlaceholderText="API地址模板（含{token}/{domain}占位）" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <ToggleSwitch IsChecked="{Binding AppConfig.DataConfig.DnsServerEnable}" OffContent="内置DNS接收服务（本机形态）" OnContent="内置DNS接收服务（本机形态）" />
                                                        <TextBlock Text="监听端口：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <NumericUpDown Width="90" Minimum="1" Maximum="65535" Value="{Binding AppConfig.DataConfig.DnsServerPort}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AppConfig.DataConfig.DnsServerStatus}" Classes="Secondary" VerticalAlignment="Center" />
                                                        <Button Content="应用" Classes="minibtn" Click="ApplyDnsServerC" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 内置服务：域名NS指向本机后开启即可直接收记录（53需管理员/root，测试可用5353等高位端口）；改端口/域名后点「应用」重启服务；" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 服务器形态：把 SuperSQLInjectionV2.DnsServer 部署到VPS（--domain 域名 --port 53 --http 8080 --token 密钥），API地址填 http://VPS:8080/api/records?token={token}&amp;type=dns&amp;filter={domain} 即可复用自动回收。" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Grid.Row="2" Classes="chgrp" Header="说明" Margin="12,10,12,10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 注入检测发现 DNS 盲注通道后，数据操作的注入类型选 DNS 即可按外带方式取数；" />
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 域名必填；Token 与 API 地址用于自动回收解析记录，留空则到 DNSLog 平台手工查看；" />
                                                    <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· API地址模板中的 {token} 与 {domain} 会被实际值替换，默认兼容 ceye.io 接口。" />
                                                </StackPanel>
                                            </GroupBox>
                                        </Grid>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgUser}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="UA池" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <Border Classes="subhead" Grid.Row="0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="开启随机UA后每请求从勾选的UA中轮换（无勾选用UA时用内置UA池）；不启用则保留报文自身User-Agent" Classes="Secondary" FontSize="11" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="随机UA" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.ByPassConfig.RandomUa}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TableView Grid.Row="1" Name="UaDataGrid" Margin="12,8"
                                                       CanUserResizeColumns="True"
                                                       ItemsSource="{Binding AppConfig.ByPassConfig.UaItemList}"
                                                       BorderThickness="1"
                                                       ScrollViewer.AllowAutoHide="True">
                                                <TableView.Columns>
                                                    <TableViewColumn Width="56" Header="选用" x:DataType="models:UaItem">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:UaItem">
                                                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Width="120" Binding="{Binding Type}" Header="类型" x:DataType="models:UaItem" />
                                                    <TableViewColumn Width="4*" Binding="{Binding Ua}" Header="User-Agent" x:DataType="models:UaItem" />
                                                </TableView.Columns>
                                                <TableView.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="删除选中" Click="RemoveUaSelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </TableView.ContextFlyout>
                                            </TableView>
                                            <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="类型：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ComboBox Width="130" VerticalAlignment="Center"
                                                              ItemsSource="{Binding UaTypeNames}"
                                                              SelectedItem="{Binding NewUaType}" />
                                                    <TextBlock Text="UA：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="460" Classes="Bordered" Text="{Binding NewUa}" VerticalAlignment="Center"
                                                             PlaceholderText="粘贴完整User-Agent串，如 Mozilla/5.0 (Windows NT 10.0; Win64; x64) ..." />
                                                    <u:IconButton Theme="{StaticResource SolidIconButton}" Classes="opadd tbtn"
                                                                  Icon="{StaticResource SemiIconPlusStroked}"
                                                                  Content="添加" Command="{Binding AddUaCommand}" VerticalAlignment="Center" />
                                                    <u:IconButton Theme="{StaticResource OutlineIconButton}"
                                                                  Icon="{StaticResource SemiIconImport}"
                                                                  Content="导入内置UA" Command="{Binding ImportBuiltinUaCommand}" VerticalAlignment="Center"
                                                                  ToolTip.Tip="把内置UA池（主流PC/手机系统UA）导入到自定义池，已存在的跳过" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <!--  字典管理：字典猜解词表（增删词条，去重忽略大小写；外部txt路径覆盖内置字典）  -->
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgBookOpen}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="字典管理" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                                            <Border Classes="subhead" Grid.Row="0">
                                                <TextBlock Text="字典猜解词表管理：Access 无元数据可读默认走字典猜解；其他库可在数据操作页开启字典猜解后使用通用字典。词条防重复（忽略大小写）" Classes="Secondary" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}" Grid.Row="1">
                                                <WrapPanel ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="字典：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <ComboBox Width="190" VerticalAlignment="Center" SelectedIndex="{Binding DictEditIndex}">
                                                            <ComboBoxItem>Access表名字典</ComboBoxItem>
                                                            <ComboBoxItem>Access字段字典</ComboBoxItem>
                                                            <ComboBoxItem>通用表名字典（其他库）</ComboBoxItem>
                                                            <ComboBoxItem>通用字段字典（其他库）</ComboBoxItem>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="过滤：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="160" VerticalAlignment="Center" Classes="ClearButton" Text="{Binding DictWordFilter}"
                                                                 PlaceholderText="过滤词条（忽略大小写）" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="表名外部txt：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="180" VerticalAlignment="Center" Text="{Binding AppConfig.DataConfig.AccessTableDictPath}" PlaceholderText="留空=内置字典" ToolTip.Tip="字典猜解表名用：Access=内置config/dict/access_tables.txt；其他库开启字典猜解后=common_tables.txt；指定外部txt则统一覆盖，且编辑Access表名字典时直接编辑该文件" />
                                                        <Button Classes="minibtn" Height="26" Content="浏览" Click="BrowseAccessTableDictC" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="字段外部txt：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="180" VerticalAlignment="Center" Text="{Binding AppConfig.DataConfig.AccessColumnDictPath}" PlaceholderText="留空=内置字典" ToolTip.Tip="字典猜解字段名用：Access=内置config/dict/access_columns.txt；其他库开启字典猜解后=common_columns.txt；指定外部txt则统一覆盖，且编辑Access字段字典时直接编辑该文件" />
                                                        <Button Classes="minibtn" Height="26" Content="浏览" Click="BrowseAccessColumnDictC" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Border>
                                            <ListBox Grid.Row="2" Name="DictWordListBox" Margin="12,8"
                                                     SelectionMode="Multiple"
                                                     BorderThickness="1" BorderBrush="{DynamicResource DsgBorder}" CornerRadius="4"
                                                     ItemsSource="{Binding DictWordItems}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="删除选中" Click="RemoveDictSelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </ListBox.ContextFlyout>
                                            </ListBox>
                                            <Border Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="词条：" Classes="Secondary" VerticalAlignment="Center" />
                                                        <TextBox Width="280" Classes="Bordered" Text="{Binding NewDictWord}" VerticalAlignment="Center"
                                                                 PlaceholderText="输入词条，如 users / admin（忽略大小写去重）" />
                                                        <u:IconButton Theme="{StaticResource SolidIconButton}" Classes="opadd tbtn"
                                                                      Icon="{StaticResource SemiIconPlusStroked}"
                                                                      Content="添加" Command="{Binding AddDictWordCommand}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DictEditHint}" Classes="Secondary" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <!--  重发设置  -->
                                    <TabItem>
                                        <TabItem.Header>
                                            <WrapPanel>
                                                <Path Classes="luc" Data="{StaticResource LgRepeat}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="重发设置" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <Border Classes="subhead" Grid.Row="0">
                                                <TextBlock Text="响应内容包含关键词时自动重发数据包" Classes="Secondary" FontSize="11" VerticalAlignment="Center" />
                                            </Border>
                                            <ListBox Grid.Row="1" Name="RetryKeyListBox" Margin="12,8"
                                                     SelectionMode="Multiple"
                                                     BorderThickness="1" BorderBrush="{DynamicResource DsgBorder}" CornerRadius="4"
                                                     ItemsSource="{Binding AppConfig.RetryKeyItems}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="删除选中" Click="RemoveRetryKeySelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </ListBox.ContextFlyout>
                                            </ListBox>
                                            <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="关键词：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="280" Classes="Bordered" Text="{Binding NewRetryKey}" VerticalAlignment="Center"
                                                             PlaceholderText="响应中包含此关键词时重发数据包" />
                                                    <u:IconButton Theme="{StaticResource SolidIconButton}" Classes="opadd tbtn"
                                                                  Icon="{StaticResource SemiIconPlusStroked}"
                                                                  Content="添加" Command="{Binding AddRetryKeyCommand}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                        </Border>

                        <!--  ======== P6 防护绕过 ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage6Visible}">
                            <TabControl TabStripPlacement="Top" BorderThickness="0" Padding="6,0,0,0" SelectedIndex="{Binding BypassTabIndex}">
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgTimer}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="频率与指纹" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <TabItem.Content>
                                        <StackPanel Margin="16,12,16,12" Spacing="10" Orientation="Vertical">
                                            <GroupBox Classes="chgrp" Header="频率限制">
                                                <StackPanel Spacing="10" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="请求固定延时(毫秒)：" Classes="Secondary" VerticalAlignment="Center" />
                                                <TextBox Width="120" Text="{Binding AppConfig.ByPassConfig.DelayMs}" VerticalAlignment="Center" PlaceholderText="0=不延时" />
                                                <TextBlock Text="（每次HTTP请求前等待）" Classes="Secondary" VerticalAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="每秒最大请求数：" Classes="Secondary" VerticalAlignment="Center" />
                                                <TextBox Width="120" Text="{Binding AppConfig.ByPassConfig.SafeFreq}" VerticalAlignment="Center" PlaceholderText="0=不限速" />
                                                <TextBlock Text="（多线程发包全局限速）" Classes="Secondary" VerticalAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Classes="chgrp" Header="协议级绕过">
                                                <StackPanel Spacing="10" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <CheckBox Content="HPP参数污染（注入参数值按空格拆分到多个同名参数，含body位并自动修正Content-Length）" IsChecked="{Binding AppConfig.ByPassConfig.HppEnabled}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <CheckBox Content="参数名大小写混淆（注入参数名每请求随机大小写，绕过参数级WAF）" IsChecked="{Binding AppConfig.ByPassConfig.ParamCaseRandEnabled}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <CheckBox Content="chunked分块发包（POST体按随机大小多块Transfer-Encoding: chunked发送，绕过长body WAF）" IsChecked="{Binding AppConfig.ByPassConfig.ChunkedEnabled}" VerticalAlignment="Center" />
                                            </StackPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </TabItem.Content>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgArrowLeftRight}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="字符替换" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <TabItem.Content>
                                        <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                                <WrapPanel ItemSpacing="10" LineSpacing="8" Margin="10,0,10,0" VerticalAlignment="Center" MinHeight="50">
                                                    <TextBlock Text="源字符：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="150" Text="{Binding AppConfig.ByPassConfig.AddReplaceItem.Src}" VerticalAlignment="Center" />
                                                    <TextBlock Text="目标字符：" Classes="Secondary"  VerticalAlignment="Center" />
                                                    <TextBox Width="150" Text="{Binding AppConfig.ByPassConfig.AddReplaceItem.Target}" VerticalAlignment="Center" />
                                                    <CheckBox Content="是否正则匹配" IsChecked="{Binding AppConfig.ByPassConfig.AddReplaceItem.IsRegex}" VerticalAlignment="Center" />
                                                    <CheckBox Content="编码前处理" IsChecked="{Binding AppConfig.ByPassConfig.AddReplaceItem.BeforEncode}" VerticalAlignment="Center" />
                                                    <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="opadd tbtn"
                                                                  Icon="{StaticResource SemiIconPlusStroked}" Content="添加" VerticalAlignment="Center"
                                                                  Command="{Binding AddRepaceModelCommand}" />
                                                </WrapPanel>
                                            </Border>
                                            <TableView Grid.Row="1"
                                                       CanUserResizeColumns="True"
                                                       Name="ReplaceDataGrid"
                                                       ItemsSource="{Binding AppConfig.ByPassConfig.ReplaceItems}"
                                                       BorderThickness="0"
                                                       ScrollViewer.AllowAutoHide="True">
                                                <TableView.Columns>
                                                    <TableViewColumn Width="*" x:DataType="models:ReplaceModel" Binding="{Binding Index}" Header="执行顺序" HorizontalContentAlignment="Center" />
                                                    <TableViewColumn Width="1.5*" x:DataType="models:ReplaceModel" Binding="{Binding Src}" Header="源字符" />
                                                    <TableViewColumn Width="1.5*" x:DataType="models:ReplaceModel" Binding="{Binding Target}" Header="目标字符" />
                                                    <TableViewColumn Header="是否替换" Width="*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:ReplaceModel">
                                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding Enable}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="是否正则" Width="*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:ReplaceModel">
                                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding IsRegex}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="编码前处理" Width="*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:ReplaceModel">
                                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding BeforEncode}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                </TableView.Columns>
                                                <TableView.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="删除选中" Click="RemoveReplaceSelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </TableView.ContextFlyout>
                                            </TableView>
                                        </Grid>
                                    </TabItem.Content>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgBinary}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="编码处理" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <TabItem.Content>
                                        <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="25,0,25,0" Spacing="10" VerticalAlignment="Center" MinHeight="40">
                                                <TextBlock Text="内置工具：" Classes="Secondary" VerticalAlignment="Center" />
                                                <ComboBox Width="220" VerticalAlignment="Center" SelectedItem="{Binding AppConfig.ByPassConfig.AddBuiltinTool}"
                                                          ItemsSource="{Binding BuiltinEncodeTools}" PlaceholderText="选择内置编码工具">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="bypass:EncodeTool">
                                                            <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                              

                                                 <u:IconButton Icon="{StaticResource SemiIconPlusStroked}" Content="添加内置" VerticalAlignment="Center" Classes="opadd tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding AddBuiltinEncodeToolCommand}"/>
                                                 <u:IconButton Icon="{StaticResource SemiIconPlusStroked}" Content="添加自定义" VerticalAlignment="Center" Classes="opadd tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding AddCustomEncodeToolCommand}"/>


                                            </StackPanel>
                                            <TableView
                                                          Grid.Row="2"
                                                          CanUserResizeColumns="True"
                                                          Name="EncodeDataGrid"
                                                          ItemsSource="{Binding AppConfig.ByPassConfig.EncodeTools}"
                                                          BorderThickness="1"
                                                          ScrollViewer.AllowAutoHide="True">
                                                <TableView.Columns>
                                                    <TableViewColumn Width="1.2*" x:DataType="models:EncodeToolModel" Binding="{Binding Name}" Header="名称" />
                                                    <TableViewColumn Header="类型" Width="0.7*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TypeText}" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="作用域" Width="1.1*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding ScopeList}" SelectedItem="{Binding Scope}"
                                                                          ToolTip.Tip="Payload级：Encode块内payload上执行；报文级：整份HTTP报文上执行">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource InjectTypeNameConverter}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="位置" Width="0.9*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <Grid HorizontalAlignment="Center">
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding PosText}" IsVisible="{Binding Builtin}" ToolTip.Tip="内置项适用位置由注册表固定（换行/控制符类工具锁定编码位）" />
                                                                    <ComboBox IsVisible="{Binding !Builtin}" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding PosList}" SelectedItem="{Binding ApplyPos}"
                                                                              ToolTip.Tip="全部位置=所有Encode块生效；仅编码位=query/URI段/urlencoded体；仅原文位=头/Cookie/JSON/XML/multipart体">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource InjectTypeNameConverter}}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="执行次数" Width="0.8*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding DoCountItems}" SelectedItem="{Binding DoCount}" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Width="2.5*" x:DataType="models:EncodeToolModel" Binding="{Binding DescText}" Header="功能说明" />
                                                    <TableViewColumn Header="是否启用" Width="0.8*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding Enable}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                    <TableViewColumn Header="操作" Width="1.2*" HorizontalContentAlignment="Center">
                                                        <TableViewColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:EncodeToolModel">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <u:IconButton Width="26" Height="26" Padding="0"
                                                                                  Theme="{DynamicResource BorderlessIconButton}"
                                                                                  Icon="{StaticResource IconEdit}"
                                                                                  ToolTip.Tip="编辑该编码工具"
                                                                                  Command="{Binding $parent[TableView].DataContext.EditEncodeToolCommand}" CommandParameter="{Binding}" />
                                                                    <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                                  Theme="{DynamicResource BorderlessIconButton}"
                                                                                  Icon="{StaticResource SemiIconDelete}"
                                                                                  ToolTip.Tip="删除该编码工具"
                                                                                  Command="{Binding $parent[TableView].DataContext.RemoveEncodeToolCommand}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </TableViewColumn.CellTemplate>
                                                    </TableViewColumn>
                                                </TableView.Columns>
                                                <TableView.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="删除选中" Click="RemoveBypassSelect">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </TableView.ContextFlyout>
                                            </TableView>
                                        </Grid>
                                    </TabItem.Content>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgSparkles}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="动态规则" VerticalAlignment="Center" ToolTip.Tip="动态值与二次注入规则统一管理" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <TabItem.Content>
                                        <TabControl BorderThickness="0" Padding="6,0,0,0" Margin="0,10,0,0" SelectedIndex="{Binding DynRuleTabIndex}">
                                            <TabItem>
                                                <TabItem.Header>
                                                    <WrapPanel>
                                                        <PathIcon Data="{StaticResource IconRandToken}" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Margin="6,0,0,0" Text="动态规则" VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                </TabItem.Header>
                                                <Grid RowDefinitions="Auto,Auto,*">
                                                    <!--  工具栏：左侧操作按钮，右侧搜索框  -->
                                                    <Grid Margin="0,10,10,10" ColumnDefinitions="Auto,*" MinHeight="40">
                                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <u:IconButton Icon="{StaticResource SemiIconPlusStroked}" Content="新 增" VerticalAlignment="Center" Classes="opadd tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding AddCompanionRuleCommand}"
                                                                          ToolTip.Tip="新增动态值（抓取HTTP响应或脚本生成动态值回填&lt;DRule&gt;标记）或二次注入（响应替代主响应取数）规则" />
                                                            <u:IconButton Icon="{StaticResource SemiIconEditStroked}" Content="修 改" VerticalAlignment="Center" Classes="opedit tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding EditCompanionRuleCommand}"
                                                                          ToolTip.Tip="编辑选中或勾选行的规则（勾选多行时取第一条；也可双击行或点操作列编辑按钮）" />
                                                            <u:IconButton Icon="{StaticResource SemiIconDeleteStroked}" Content="删 除" VerticalAlignment="Center" Classes="opdel tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding RemoveCheckedCompanionRulesCommand}"
                                                                          ToolTip.Tip="弹窗确认后批量删除勾选行的规则" />
                                                            <u:IconButton Icon="{StaticResource SemiIconCodeStroked}" Content="管理脚本" VerticalAlignment="Center" Classes="tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding ManageTokenScriptsCommand}"
                                                                          ToolTip.Tip="切换到脚本管理选项卡，管理全部动态值抓取/生成脚本" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBox Width="190" Height="30" VerticalAlignment="Center"
                                                                     Text="{Binding DynRuleSearchKeyword}"
                                                                     PlaceholderText="名称/标记名/类型/来源/摘要">
                                                                <TextBox.InnerLeftContent>
                                                                    <PathIcon Data="{StaticResource SemiIconSearchStroked}" Width="13" Height="13" Margin="8,0,0,0"
                                                                              Foreground="{DynamicResource DsgInk3}" />
                                                                </TextBox.InnerLeftContent>
                                                            </TextBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TableView Grid.Row="2"
                                                               CanUserResizeColumns="True"
                                                               Name="CompanionRuleTable"
                                                               ItemsSource="{Binding FilteredCompanionRules}"
                                                               SelectedItem="{Binding SelectedCompanionRule}"
                                                               BorderThickness="1"
                                                               ScrollViewer.AllowAutoHide="True"
                                                               DoubleTapped="CompanionRuleTable_DoubleTapped">
                                                        <TableView.Columns>
                                                            <TableViewColumn Header="选择" Width="0.45*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:CompanionRequestConfig">
                                                                        <CheckBox IsChecked="{Binding RowChecked}" Click="RowCheckSelectC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                            <TableViewColumn Header="启用" Width="0.6*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:CompanionRequestConfig">
                                                                        <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                            <TableViewColumn Width="1.2*" x:DataType="models:CompanionRequestConfig" Binding="{Binding Name}" Header="名称" />
                                                            <TableViewColumn Width="0.8*" x:DataType="models:CompanionRequestConfig" Binding="{Binding TagName}" Header="标记名" />
                                                            <TableViewColumn Width="1.1*" x:DataType="models:CompanionRequestConfig" Binding="{Binding KindName}" Header="类型" />
                                                            <TableViewColumn Width="0.8*" x:DataType="models:CompanionRequestConfig" Binding="{Binding SourceName}" Header="来源" />
                                                            <TableViewColumn Width="0.9*" x:DataType="models:CompanionRequestConfig" Binding="{Binding ExtractName}" Header="取值方式" />
                                                            <TableViewColumn Width="3*" x:DataType="models:CompanionRequestConfig" Binding="{Binding Summary}" Header="URL/报文/脚本摘要" />
                                                            <TableViewColumn Header="操作" Width="1*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:CompanionRequestConfig">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <u:IconButton Width="26" Height="26" Padding="0"
                                                                                          Theme="{DynamicResource BorderlessIconButton}"
                                                                                          Icon="{StaticResource IconEdit}"
                                                                                          ToolTip.Tip="编辑该规则"
                                                                                          Command="{Binding $parent[TableView].DataContext.EditCompanionRuleCommand}" CommandParameter="{Binding}" />
                                                                            <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                                          Theme="{DynamicResource BorderlessIconButton}"
                                                                                          Icon="{StaticResource SemiIconDelete}"
                                                                                          ToolTip.Tip="删除该规则"
                                                                                          Command="{Binding $parent[TableView].DataContext.RemoveCompanionRuleCommand}" CommandParameter="{Binding}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                        </TableView.Columns>
                                                    </TableView>
                                                </Grid>
                                            </TabItem>
                                            <TabItem>
                                                <TabItem.Header>
                                                    <WrapPanel>
                                                        <PathIcon Data="{StaticResource IconCodeScript}" Width="14" Height="14" VerticalAlignment="Center" />
                                                        <TextBlock Margin="6,0,0,0" Text="脚本管理" VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                </TabItem.Header>
                                                <Grid RowDefinitions="Auto,Auto,*">
                                                    <!--  工具栏：左侧操作按钮，右侧搜索框  -->
                                                    <Grid Margin="0,10,0,10" ColumnDefinitions="Auto,*" MinHeight="40">
                                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <u:IconButton Icon="{StaticResource SemiIconPlusStroked}" Content="新 增" VerticalAlignment="Center" Classes="opadd tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding AddTokenScriptCommand}"
                                                                          ToolTip.Tip="JS脚本（QuickJS执行），需定义 function tamper(response){...}；弹窗内可粘贴响应报文直接验证提取结果" />
                                                            <u:IconButton Icon="{StaticResource SemiIconEditStroked}" Content="修 改" VerticalAlignment="Center" Classes="opedit tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding EditTokenScriptCommand}"
                                                                          ToolTip.Tip="编辑选中或勾选行的脚本（勾选多行时取第一条；也可点操作列编辑按钮）" />
                                                            <u:IconButton Icon="{StaticResource SemiIconDeleteStroked}" Content="删除选中" VerticalAlignment="Center" Classes="opdel tbtn"
                                                                          Theme="{DynamicResource SolidIconButton}" Command="{Binding RemoveCheckedTokenScriptsCommand}"
                                                                          ToolTip.Tip="弹窗确认后批量删除勾选行的脚本，引用这些脚本的规则将清空脚本设置" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBox Width="190" Height="30" VerticalAlignment="Center"
                                                                     Text="{Binding TokenScriptSearchKeyword}"
                                                                     PlaceholderText="名称/类型模糊搜索">
                                                                <TextBox.InnerLeftContent>
                                                                    <PathIcon Data="{StaticResource SemiIconSearchStroked}" Width="13" Height="13" Margin="8,0,0,0"
                                                                              Foreground="{DynamicResource DsgInk3}" />
                                                                </TextBox.InnerLeftContent>
                                                            </TextBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TableView Grid.Row="2"
                                                               CanUserResizeColumns="True"
                                                               Name="TokenScriptDataGrid"
                                                               ItemsSource="{Binding FilteredTokenScripts}"
                                                               SelectedItem="{Binding SelectedTokenScript}"
                                                               BorderThickness="1"
                                                               ScrollViewer.AllowAutoHide="True">
                                                        <TableView.Columns>
                                                            <TableViewColumn Header="选择" Width="0.45*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:ScriptTamperModel">
                                                                        <CheckBox IsChecked="{Binding RowChecked}" Click="RowCheckSelectC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                            <TableViewColumn Header="启用" Width="0.6*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:ScriptTamperModel">
                                                                        <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" IsChecked="{Binding Enable}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                            <TableViewColumn Width="2*" x:DataType="models:ScriptTamperModel" Binding="{Binding Name}" Header="名称" />
                                                            <TableViewColumn Width="1.2*" x:DataType="models:ScriptTamperModel" Binding="{Binding KindName}" Header="类型" />
                                                            <TableViewColumn Header="操作" Width="1*" HorizontalContentAlignment="Center">
                                                                <TableViewColumn.CellTemplate>
                                                                    <DataTemplate x:DataType="models:ScriptTamperModel">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <u:IconButton Width="26" Height="26" Padding="0"
                                                                                          Theme="{DynamicResource BorderlessIconButton}"
                                                                                          Icon="{StaticResource IconEdit}"
                                                                                          ToolTip.Tip="编辑该脚本"
                                                                                          Command="{Binding $parent[TableView].DataContext.EditTokenScriptCommand}" CommandParameter="{Binding}" />
                                                                            <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                                          Theme="{DynamicResource BorderlessIconButton}"
                                                                                          Icon="{StaticResource SemiIconDelete}"
                                                                                          ToolTip.Tip="删除该脚本"
                                                                                          Command="{Binding $parent[TableView].DataContext.RemoveTokenScriptCommand}" CommandParameter="{Binding}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </TableViewColumn.CellTemplate>
                                                            </TableViewColumn>
                                                        </TableView.Columns>
                                                    </TableView>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </TabItem.Content>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!--  ======== P10 检测用例（搜索筛选 + 弹窗查看/新增 + 操作列删除确认） ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage10Visible}">
                            <TabControl BorderThickness="0" Margin="0,4,0,0">
                                <!--  ======== 检测用例 ========  -->
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgFileCode}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="检测用例" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <!--  搜索行：标签+控件成组包裹（换行不拆对）；计数钉在右端  -->
                                <Grid Margin="25,15,25,0" ColumnDefinitions="*,Auto">
                                    <WrapPanel ItemSpacing="14" LineSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="关键字：" Classes="Secondary" VerticalAlignment="Center" />
                                            <TextBox Width="170" Height="30" VerticalAlignment="Center"
                                                     Text="{Binding PayloadSearchKeyword}"
                                                     PlaceholderText="标题/payload模糊搜索" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="技术类型：" Classes="Secondary" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Height="30" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PayloadSTypeFilters}"
                                                      SelectedItem="{Binding PayloadFilterSType}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="级别：" Classes="Secondary" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Height="30" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PayloadLevelFilters}"
                                                      SelectedItem="{Binding PayloadFilterLevel}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="风险：" Classes="Secondary" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Height="30" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PayloadRiskFilters}"
                                                      SelectedItem="{Binding PayloadFilterRisk}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="DBMS：" Classes="Secondary" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Height="30" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PayloadDbmsFilters}"
                                                      SelectedItem="{Binding PayloadFilterDbms}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="文件：" Classes="Secondary" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Height="30" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PayloadFileFilters}"
                                                      SelectedItem="{Binding SelectedPayloadFileFilter}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                                <!--  操作行  -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="25,8,25,8" Spacing="10">
                                    <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="opadd tbtn"
                                                  Icon="{StaticResource SemiIconPlusStroked}" Content="新增用例"
                                                  VerticalAlignment="Center" Command="{Binding AddPayloadCommand}"
                                                  ToolTip.Tip="弹窗编辑，写入custom_user.xml，不污染官方用例文件" />
                                    <u:IconButton Theme="{DynamicResource OutlineIconButton}" Classes="tbtn"
                                                  Icon="{StaticResource IconRefresh}" Content="重新加载"
                                                  VerticalAlignment="Center" Command="{Binding ReloadPayloadsCommand}" />
                                    <TextBlock Classes="Secondary" VerticalAlignment="Center" FontSize="10.5"
                                               Text="说明：自定义用例建议写入custom_user.xml，与官方用例文件分离。保存后立即对后续检测生效。" />
                                </StackPanel>
                                <!--  用例列表  -->
                                <TableView Grid.Row="2"
                                           CanUserResizeColumns="True"
                                           ItemsSource="{Binding PayloadItems}"
                                           BorderThickness="1"
                                           ScrollViewer.AllowAutoHide="True">
                                    <TableView.Columns>
                                        <TableViewColumn Width="3*" Binding="{Binding Title}" Header="用例标题" x:DataType="detectmodels:PayloadItem" />
                                        <TableViewColumn Width="100" Binding="{Binding STypeName}" Header="技术类型" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="55" Binding="{Binding Level}" Header="级别" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="55" Binding="{Binding Risk}" Header="风险" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="130" Binding="{Binding Dbms}" Header="适用DBMS" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Left" />
                                        <TableViewColumn Width="140" Binding="{Binding FileName}" Header="所在文件" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Left" />
                                        <TableViewColumn Width="75" Binding="{Binding HitCount}" Header="命中次数" x:DataType="detectmodels:PayloadItem" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="100" Header="操作" HorizontalContentAlignment="Center">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="detectmodels:PayloadItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <u:IconButton Width="26" Height="26" Padding="0"
                                                                      Theme="{DynamicResource BorderlessIconButton}"
                                                                      Icon="{StaticResource IconView}"
                                                                      Foreground="{DynamicResource DsgInk2}"
                                                                      Tag="{Binding}" Click="ViewPayloadRow"
                                                                      ToolTip.Tip="弹窗查看/编辑该用例" />
                                                        <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                      Theme="{DynamicResource BorderlessIconButton}"
                                                                      Icon="{StaticResource SemiIconDelete}"
                                                                      Tag="{Binding}" Click="DeletePayloadRow"
                                                                      ToolTip.Tip="删除该用例（需确认）" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                    </TableView.Columns>
                                </TableView>
                                <!--  分页栏  -->
                                <Border Grid.Row="3" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource DsgPrimary}"
                                                   Text="{Binding PayloadPageInfo}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Theme="{DynamicResource OutlineButton}" Content="首页" Width="64" Height="28"
                                                    Command="{Binding PayloadFirstPageCommand}" />
                                            <Button Theme="{DynamicResource OutlineButton}" Content="上一页" Width="72" Height="28"
                                                    Command="{Binding PayloadPrevPageCommand}" />
                                            <TextBlock VerticalAlignment="Center" Classes="Secondary"
                                                       Text="{Binding PayloadPageIndex, StringFormat='第 {0} 页'}" />
                                            <Button Theme="{DynamicResource OutlineButton}" Content="下一页" Width="72" Height="28"
                                                    Command="{Binding PayloadNextPageCommand}" />
                                            <Button Theme="{DynamicResource OutlineButton}" Content="末页" Width="64" Height="28"
                                                    Command="{Binding PayloadLastPageCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                                </TabItem>
                                <!--  ======== 报错指纹（errors.xml 管理） ========  -->
                                <TabItem>
                                    <TabItem.Header>
                                        <WrapPanel>
                                            <Path Classes="luc" Data="{StaticResource LgRadar}" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="报错指纹" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                        <!--  筛选行  -->
                                        <Grid Margin="25,10,25,0" ColumnDefinitions="*,Auto">
                                            <WrapPanel ItemSpacing="14" LineSpacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="关键字：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <TextBox Width="220" Height="30" VerticalAlignment="Center"
                                                             Text="{Binding FingerprintSearchKeyword}"
                                                             PlaceholderText="DBMS/fork/正则模糊搜索" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="DBMS：" Classes="Secondary" VerticalAlignment="Center" />
                                                    <ComboBox Width="150" Height="30" VerticalAlignment="Center"
                                                              ItemsSource="{Binding FingerprintDbmsFilters}"
                                                              SelectedItem="{Binding FingerprintFilterDbms}" />
                                                </StackPanel>
                                                <TextBlock Classes="Secondary" VerticalAlignment="Center" FontSize="10.5"
                                                           Text="{Binding FingerprintCountInfo}" />
                                            </WrapPanel>
                                        </Grid>
                                        <!--  操作行 + 命中测试  -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="25,8,25,8" Spacing="10">
                                            <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="opadd tbtn"
                                                          Icon="{StaticResource SemiIconPlusStroked}" Content="新增指纹"
                                                          VerticalAlignment="Center" Command="{Binding AddFingerprintCommand}"
                                                          ToolTip.Tip="弹窗编辑，写入 config/injection/errors.xml，保存后立即生效" />
                                            <u:IconButton Theme="{DynamicResource OutlineIconButton}" Classes="tbtn"
                                                          Icon="{StaticResource IconRefresh}" Content="重新加载"
                                                          VerticalAlignment="Center" Command="{Binding ReloadFingerprintsCommand}" />
                                            <Border Width="1" Background="{DynamicResource DsgBorder}" Margin="6,2" />
                                            <TextBlock Text="命中测试：" Classes="Secondary" VerticalAlignment="Center" />
                                            <TextBox Width="300" Height="30" VerticalAlignment="Center"
                                                     Text="{Binding FingerprintTestText}"
                                                     PlaceholderText="粘贴一段响应文本，测试命中哪些指纹" />
                                            <Button Theme="{DynamicResource OutlineButton}" Content="测试" Width="70"
                                                    VerticalAlignment="Center" Command="{Binding TestFingerprintHitCommand}" />
                                            <TextBlock Classes="Secondary" VerticalAlignment="Center" FontSize="10.5"
                                                       Text="{Binding FingerprintTestResult}" />
                                        </StackPanel>
                                        <!--  指纹列表  -->
                                        <TableView Grid.Row="2"
                                                   CanUserResizeColumns="True"
                                                   ItemsSource="{Binding FingerprintItems}"
                                                   BorderThickness="1"
                                                   ScrollViewer.AllowAutoHide="True">
                                            <TableView.Columns>
                                                <TableViewColumn Width="160" Binding="{Binding Dbms}" Header="DBMS" x:DataType="detectmodels:FingerprintItem" HorizontalContentAlignment="Left" />
                                                <TableViewColumn Width="110" Binding="{Binding Fork}" Header="fork衍生库" x:DataType="detectmodels:FingerprintItem" HorizontalContentAlignment="Left" />
                                                <TableViewColumn Width="5*" Binding="{Binding Regexp}" Header="正则表达式" x:DataType="detectmodels:FingerprintItem" HorizontalContentAlignment="Left" />
                                                <TableViewColumn Width="100" Header="操作" HorizontalContentAlignment="Center">
                                                    <TableViewColumn.CellTemplate>
                                                        <DataTemplate x:DataType="detectmodels:FingerprintItem">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <u:IconButton Width="26" Height="26" Padding="0"
                                                                              Theme="{DynamicResource BorderlessIconButton}"
                                                                              Icon="{StaticResource IconView}"
                                                                              Foreground="{DynamicResource DsgInk2}"
                                                                              Tag="{Binding}" Click="EditFingerprintRow"
                                                                              ToolTip.Tip="弹窗查看/编辑该指纹" />
                                                                <u:IconButton Width="26" Height="26" Padding="0" Classes="Danger"
                                                                              Theme="{DynamicResource BorderlessIconButton}"
                                                                              Icon="{StaticResource SemiIconDelete}"
                                                                              Tag="{Binding}" Click="DeleteFingerprintRow"
                                                                              ToolTip.Tip="删除该指纹（需确认）" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </TableViewColumn.CellTemplate>
                                                </TableViewColumn>
                                            </TableView.Columns>
                                        </TableView>
                                        <!--  分页栏  -->
                                        <Border Grid.Row="3" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource DsgPrimary}"
                                                           Text="{Binding FingerprintPageInfo}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Theme="{DynamicResource OutlineButton}" Content="首页" Width="64" Height="28"
                                                            Command="{Binding FingerprintFirstPageCommand}" />
                                                    <Button Theme="{DynamicResource OutlineButton}" Content="上一页" Width="72" Height="28"
                                                            Command="{Binding FingerprintPrevPageCommand}" />
                                                    <TextBlock VerticalAlignment="Center" Classes="Secondary"
                                                               Text="{Binding FingerprintPageIndex, StringFormat='第 {0} 页'}" />
                                                    <Button Theme="{DynamicResource OutlineButton}" Content="下一页" Width="72" Height="28"
                                                            Command="{Binding FingerprintNextPageCommand}" />
                                                    <Button Theme="{DynamicResource OutlineButton}" Content="末页" Width="64" Height="28"
                                                            Command="{Binding FingerprintLastPageCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <!--  ======== P9 取数模版（独立一级页面，原属防护绕过选项卡） ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage9Visible}">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="15,15,25,5">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="数据库：" Classes="Secondary" VerticalAlignment="Center" />
                                        <ComboBox Width="160" SelectedItem="{Binding SelectedTemplateDb}" ItemsSource="{Binding TemplateDbList}" />
                                        <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="tbtn"
                                                      Icon="{StaticResource SemiIconSaveStroked}" Content="保存并生效"
                                                      VerticalAlignment="Center" Command="{Binding SaveTemplateCommand}" />
                                        <u:IconButton Theme="{DynamicResource OutlineIconButton}" Classes="tbtn"
                                                      Icon="{StaticResource IconRefresh}" Content="重新加载"
                                                      VerticalAlignment="Center" Command="{Binding LoadTemplateCommand}" />
                                        <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="opadd tbtn"
                                                      Icon="{StaticResource SemiIconPlusStroked}" Content="添加模板项"
                                                      VerticalAlignment="Center" Command="{Binding AddTemplateItemCommand}" />
                                    </StackPanel>
                                   
                                        <PathIcon Grid.Column="1" Width="18" Height="18" Data="{StaticResource IconHelp}">
                                        <ToolTip.Tip>
                                            <ToolTip MaxWidth="560" >
                                                <TextBlock TextWrapping="Wrap" LineHeight="20"
                                                           Text="说明：key:value对应config/payload下模板文件的一行，占位符为命名风格（见下方词汇表），各库模板只需引用需要的槽位。保存后立即热生效（当前取数库），并同步写回模板文件。删除必需key会导致取数异常，保存时会给出警告。&#xA;&#xA;占位符词汇表：{expr}=表达式 {start}/{len}=截子串位置/长度 {value}=布尔比较值 {cond}/{sleep}/{alias}=时间盲注条件/秒数/别名 {cols}=列串或数据表达式 {db}=库名 {table}=表名 {rowIndex}=行索引 {where}=where过滤 {batchSize}=批量行数 {fill}=Union外层填充列串 {index}=枚举序号 {split}/{startMark}/{endMark}=数据分隔/起始/结束标记 {cmd}=命令 {path}=文件路径 {content}=内容 {data}=数据" />
                                            </ToolTip>
                                        </ToolTip.Tip>
                                        </PathIcon>
                                </Grid>
                                <TableView
                                          Grid.Row="1"
                                          CanUserResizeColumns="True"
                                          Name="PayloadTemplateDataGrid"
                                          ItemsSource="{Binding TemplateItems}"
                                          SelectedItem="{Binding SelectedTemplateItem}"
                                          BorderThickness="1"
                                          ScrollViewer.AllowAutoHide="True">
                                    <TableView.Columns>
                                        <TableViewColumn Width="*" Header="模板Key">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:PayloadTemplateItem">
                                                    <TextBox Text="{Binding Key}" BorderThickness="0" Background="Transparent"
                                                             MinHeight="0" Padding="0" VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center" />
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                        <TableViewColumn Width="2.6*" x:DataType="models:PayloadTemplateItem" Binding="{Binding Desc}" Header="用途描述" />
                                        <TableViewColumn Width="5.4*" Header="模板Value（SQL模板，命名占位符见右上角问号图标）">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:PayloadTemplateItem">
                                                    <TextBox Text="{Binding Value}" BorderThickness="0" Background="Transparent"
                                                             MinHeight="0" Padding="0" VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center" />
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                        <TableViewColumn Width="70" Header="操作" HorizontalContentAlignment="Center">
                                            <TableViewColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:PayloadTemplateItem">
                                                    <u:IconButton Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                                                                  Theme="{DynamicResource BorderlessIconButton}"
                                                                  Icon="{StaticResource IconEdit}"
                                                                  Command="{Binding $parent[TableView].DataContext.EditTemplateItemCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip.Tip="弹窗编辑该模板项的Key/Value" />
                                                </DataTemplate>
                                            </TableViewColumn.CellTemplate>
                                        </TableViewColumn>
                                    </TableView.Columns>
                                    <TableView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="删除选中行" Click="RemoveTemplateRow">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </TableView.ContextFlyout>
                                </TableView>
                            </Grid>
                        </Border>

                        <!--  ======== P7 编码工具（上下布局：输入/结果，底部操作行用下拉选择编码/解码类型执行） ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage7Visible}">
                            <Grid RowDefinitions="*,*,Auto">
                                <!--  输入区  -->
                                <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Grid.Row="0" Classes="Secondary" Text="输入：" Margin="0,0,0,5" />
                                        <TextBox Grid.Row="1" Classes="TextArea" AcceptsReturn="True" TextWrapping="Wrap"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding EncodeTools.Input}"
                                                 PlaceholderText="请输入要编码或解码的内容" />
                                    </Grid>
                                </Border>
                                <!--  结果区  -->
                                <Border Grid.Row="1" Padding="12,10">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Grid.Row="0" Classes="Secondary" Text="结果：" Margin="0,0,0,5" />
                                        <TextBox Grid.Row="1" Classes="TextArea" AcceptsReturn="True" TextWrapping="Wrap"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding EncodeTools.Output}"
                                                 PlaceholderText="编码或解码结果" />
                                    </Grid>
                                </Border>
                                <!--  底部操作行：编码/解码类型下拉 + 执行  -->
                                <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="编码：" Classes="Secondary" VerticalAlignment="Center" />
                                        <ComboBox Width="150" VerticalAlignment="Center"
                                                  ItemsSource="{Binding EncodeTools.EncodeMethods}"
                                                  SelectedItem="{Binding EncodeTools.SelectedEncode}" />
                                        <Button VerticalAlignment="Center" Padding="16,0"
                                                Content="编 码" Command="{Binding EncodeTools.EncodeCommand}" />
                                        <u:ToolBarSeparator />
                                        <TextBlock Text="解码：" Classes="Secondary" VerticalAlignment="Center" />
                                        <ComboBox Width="150" VerticalAlignment="Center"
                                                  ItemsSource="{Binding EncodeTools.DecodeMethods}"
                                                  SelectedItem="{Binding EncodeTools.SelectedDecode}" />
                                        <Button VerticalAlignment="Center" Padding="16,0"
                                                Content="解 码" Command="{Binding EncodeTools.DecodeCommand}" />
                                        <u:ToolBarSeparator />
                                        <Button Theme="{DynamicResource OutlineButton}" VerticalAlignment="Center"
                                                Content="结果→输入" Command="{Binding EncodeTools.SwapCommand}" />
                                        <Button Theme="{DynamicResource OutlineButton}" VerticalAlignment="Center"
                                                Content="清 空" Command="{Binding EncodeTools.ClearCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  ======== P8 请求日志 ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage8Visible}">
                            <Grid RowDefinitions="*,Auto,*">
                                <TableView Grid.Row="0" Name="RequestLogTable"
                                           CanUserResizeColumns="True"
                                           ItemsSource="{Binding AppConfig.RequestLog.Items}"
                                           SelectedItem="{Binding AppConfig.RequestLog.SelectItem}"
                                           BorderThickness="1"
                                           ScrollViewer.AllowAutoHide="True">
                                    <TableView.Columns>
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding index}" Header="序号" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="5*" x:DataType="models:RequestLog" Binding="{Binding Payload}" Header="Payload" />
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding Request.Host}" Header="主机" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding Request.Port}" Header="端口" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="1.2*" x:DataType="models:RequestLog" Binding="{Binding Proxy}" Header="代理" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding Response.StatusCode}" Header="状态码" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding UseTime}" Header="用时" HorizontalContentAlignment="Center" />
                                        <TableViewColumn Width="*" x:DataType="models:RequestLog" Binding="{Binding Response.BodyLength}" Header="响应内容长度" HorizontalContentAlignment="Center" />
                                    </TableView.Columns>
                                    <TableView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="清空" Command="{Binding ClearLogsCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource SemiIconDelete}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="复制值" Command="{Binding CopyPayloadCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource SemiIconCopy}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </TableView.ContextFlyout>
                                </TableView>
                                <!--  细分隔线+透明拖拽热区（与数据管理页同款，替代默认粗灰GridSplitter）  -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource DsgBorder}" />
                                <GridSplitter Grid.Row="1" Height="5" Background="Transparent" HorizontalAlignment="Stretch" />
                                <Grid RowDefinitions="Auto,*" Grid.Row="2">
                                    <TextBox Height="30" Classes="Bordered" Margin="0,6,0,0" Text="{Binding AppConfig.RequestLog.SelectItem?.Payload}" />
                                    <TabControl Grid.Row="1" BorderThickness="0">
                                        <TabItem>
                                            <TabItem.Header>
                                                <WrapPanel>
                                                    <PathIcon Data="{StaticResource IconHttpRequest}" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Margin="6,0,0,0" Text="请求包" VerticalAlignment="Center" />
                                                </WrapPanel>
                                            </TabItem.Header>
                                            <TabItem.Content>
                                                <AvaloniaEditor:TextEditor Margin="0,10,0,0"
                                                                     ShowLineNumbers="True"
                                                                     Document="{Binding AppConfig.RequestLog.RequestTxt}"
                                                                     FontFamily="{StaticResource CodeFontFamily}"
                                                                     HorizontalScrollBarVisibility="Auto"
                                                                     Name="RequestLogBox"
                                                                     Watermark="请求包">
                                                    <AvaloniaEditor:TextEditor.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="Copy" InputGesture="ctrl+C" Command="{ReflectionBinding CopyMouseCommand}" CommandParameter="{Binding #RequestLogBox.TextArea}" >
                                                                <MenuItem.Icon>
                                                                    <PathIcon Data="{StaticResource SemiIconCopy}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </AvaloniaEditor:TextEditor.ContextFlyout>
                                                </AvaloniaEditor:TextEditor>
                                            </TabItem.Content>
                                        </TabItem>
                                        <TabItem>
                                            <TabItem.Header>
                                                <WrapPanel>
                                                    <PathIcon Data="{StaticResource IconHttpResponse}" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Margin="6,0,0,0" Text="响应包" VerticalAlignment="Center" />
                                                </WrapPanel>
                                            </TabItem.Header>
                                            <TabItem.Content>
                                                <AvaloniaEditor:TextEditor  Name="ResponseLogBox"
                                                                           Grid.Row="0"
                                                                           ShowLineNumbers="True"
                                                                           Document="{Binding AppConfig.RequestLog.ResponseText}"
                                                                           FontFamily="{StaticResource CodeFontFamily}"
                                                                           HorizontalScrollBarVisibility="Auto"
                                                                           VerticalScrollBarVisibility="Visible"
                                                                           Watermark="响应包" />
                                            </TabItem.Content>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  ======== P11 关于（软件介绍 + 问题反馈） ========  -->
                        <Border Classes="pageflat" IsVisible="{Binding NavPage11Visible}">
                            <Grid ColumnDefinitions="5*,4*" Margin="16">
                                <!--  左：软件介绍  -->
                                <GroupBox Grid.Column="0" Classes="chgrp" Header="软件介绍" Margin="0,0,8,0" Padding="16,14,16,16">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="46" Height="46" CornerRadius="4"
                                                    BoxShadow="0 4 10 -4 #662563EB">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="20%,0%" EndPoint="80%,100%">
                                                        <GradientStop Color="{DynamicResource DsgPrimaryColor}" Offset="0" />
                                                        <GradientStop Color="{DynamicResource DsgPrimaryHoverColor}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Path Classes="luc" Data="{StaticResource LgDatabaseZap}" Stroke="#FFFFFF" Width="24" Height="24" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="超级SQL注入工具V2" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource DsgPrimaryTint2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AppVersionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DsgPrimary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="跨平台 SQL 注入检测与数据利用工具" FontSize="12" Foreground="{DynamicResource DsgInk3}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Height="1" Background="{DynamicResource DsgBorder}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                                   Text="一款图形化 SQL 注入测试工具，基于 Avalonia 跨平台运行（Windows / macOS / Linux），配套命令行版本 SuperSQLInjectionV2.Cmd 支持脚本化批量检测。" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="核心能力" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap" Text="· 注入检测：Bool盲注 / 报错 / Union / 时间盲注 / 堆叠 / DNS外带，Level 1-5 与 Risk 1-3 分级用例，网页相似度抗噪与智能模式" />
                                            <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap" Text="· 数据获取：环境变量、库表列结构、行数据 dump（分片/断点续传/中文识别）、自定义 SQL、Hash 读取、权限角色" />
                                            <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap" Text="· 文件与命令：各数据库读文件 / 写文件 / 命令执行（MySQL UDF、SQLServer xp_cmdshell、PG UDF 等多通道）" />
                                            <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap" Text="· 防护绕过：内置编码工具链 + 自定义 JS 编码工具，字符替换、Chunked 分块、随机 UA / 代理池" />
                                            <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap" Text="· 支持数据库：MySQL / SQLServer / PostgreSQL / SQLite / Oracle / Access / DB2 / 达梦 等" />
                                        </StackPanel>
                                        <Border Height="1" Background="{DynamicResource DsgBorder}" />
                                        <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                                                   Text="本工具仅限授权范围内的安全测试与学习研究使用，请勿用于非法用途。" />
                                    </StackPanel>
                                </GroupBox>

                                <!--  右：软件更新 + 问题反馈  -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                                    <!--  软件更新卡片（整合原 网络设置-软件更新 全部配置）  -->
                                    <GroupBox Grid.Row="0" Classes="chgrp" Header="软件更新" Margin="8,0,0,0" Padding="16,12,16,14">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="当前版本" Classes="Secondary" FontSize="12" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource DsgPrimaryTint2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppVersionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DsgPrimary}" />
                                                </Border>
                                                <TextBlock Text="自动检测" Classes="Secondary" VerticalAlignment="Center" />
                                                <ToggleSwitch Theme="{StaticResource SimpleToggleSwitch}" Classes="se" IsChecked="{Binding AppConfig.UpdateCheckEnable}" VerticalAlignment="Center"
                                                              ToolTip.Tip="软件启动后自动向更新服务检测新版本（服务地址在 config/update.ini 中配置）" />
                                                <u:IconButton Theme="{StaticResource SolidIconButton}" Icon="{StaticResource LgRefreshCw}"
                                                              Content="检查更新" Command="{Binding CheckUpdateNowCommand}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UpdateStatusText}" Classes="Secondary" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 接入 SoftUpdate 自托管更新服务：勾选「自动检测」后，每次启动在后台检测一次，发现新版本弹窗提示（含更新说明），可选择下载或跳过该版本；" />
                                                <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 更新服务连接配置（服务地址/应用标识/渠道/客户端Key）写在 config/update.ini 中，随软件分发，UI 不提供修改，改后重启生效；" />
                                                <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 下载位置：更新包按版本号存到软件运行目录 update/{版本号}/ 下，逐文件 SHA256 校验，与安装目录一致的文件直接复制（文件级增量），关闭软件后解压覆盖即可完成升级；" />
                                                <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 服务地址为空时不检测、不报错；检测失败仅在运行日志记录，不打断使用；" />
                                                <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap" Text="· 服务端部署与版本发布见 SoftUpdate 工程 docs/API.md（默认端口 5900，版本需先在管理端发布后客户端可见）。" />
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <!--  问题反馈卡片  -->
                                    <GroupBox Grid.Row="1" Classes="chgrp" Header="问题反馈" Margin="8,12,0,0" Padding="16,14,16,16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="Secondary" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="使用中遇到的问题、建议或功能需求，欢迎提交反馈。也可在github项目地址中反馈。" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="反馈内容" FontSize="12" FontWeight="SemiBold" />
                                            <TextBox Classes="Bordered" MinHeight="150" MaxHeight="260" AcceptsReturn="True" TextWrapping="Wrap"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding FeedbackContent}"
                                                     PlaceholderText="请描述问题现象、复现步骤或建议（必填，4000 字以内）" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="联系方式" FontSize="12" FontWeight="SemiBold" />
                                            <TextBox Classes="Bordered" Text="{Binding FeedbackContact}"
                                                     PlaceholderText="邮箱 / QQ / 微信（选填，便于回访，200 字以内）" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <u:IconButton Theme="{StaticResource SolidIconButton}" Icon="{StaticResource LgSend}"
                                                          Content="提交反馈" Command="{Binding SubmitFeedbackCommand}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FeedbackStatusText}" Classes="Secondary" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Classes="Secondary" FontSize="11" TextWrapping="Wrap"
                                                   Text="提交依赖上方「软件更新」卡片中的服务地址配置；服务不可达时会提示失败，不影响软件正常使用。" />
                                    </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  ============ 日志区（网络设置/防护绕过/编码工具/请求日志页隐藏，行高Auto随IsVisible塌陷） ============  -->
                    <Border Classes="pageflat" Grid.Row="3" Height="180" MinHeight="130" IsVisible="{Binding LogPanelVisible}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DsgBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="38" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DsgBorder}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconCodeScript}" Width="14" Height="14" Foreground="{DynamicResource DsgPrimary}" />
                                        <TextBlock Text="运行日志" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Button Classes="chip" Classes.on="{Binding LogFilter0On}" Content="全部"
                                                Command="{Binding SelectLogFilterCommand}" CommandParameter="0" />
                                        <Button Classes="chip" Classes.on="{Binding LogFilter1On}" Content="信息"
                                                Command="{Binding SelectLogFilterCommand}" CommandParameter="1" />
                                        <Button Classes="chip" Classes.on="{Binding LogFilter2On}" Content="成功"
                                                Command="{Binding SelectLogFilterCommand}" CommandParameter="2" />
                                        <Button Classes="chip" Classes.on="{Binding LogFilter3On}" Content="警告/错误"
                                                Command="{Binding SelectLogFilterCommand}" CommandParameter="3" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                                        <Button Classes="minibtn" Click="LogClearC">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource SemiIconDelete}" Width="12" Height="12" />
                                                <TextBlock Text="清空" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="minibtn" Command="{Binding ToggleLogPanelCommand}" ToolTip.Tip="收起日志面板（状态栏「日志」按钮可重新展开）">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="收起" VerticalAlignment="Center" />
                                                <TextBlock Text="▾" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <AvaloniaEditor:TextEditor Name="TxtLog" FontSize="12"
                                               IsReadOnly="True" ShowLineNumbers="False"
                                               Background="{DynamicResource DsgCodeBg}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                                               FontFamily="{StaticResource CodeFontFamily}"
                                               WordWrap="True">
                                <AvaloniaEditor:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制" Click="LogCopyC">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SemiIconCopyStroked}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="全选" Click="LogSelectAllC" >
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource IconSelectAll}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="导出日志" Click="LogExportC">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SemiIconDownloadStroked}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="清空日志" Click="LogClearC">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SemiIconDelete}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </AvaloniaEditor:TextEditor.ContextMenu>
                            </AvaloniaEditor:TextEditor>
                        </DockPanel>
                    </Border>

                    <!--  ============ 状态栏 ============  -->
                    <Border Grid.Row="4" Height="32" Padding="10,0"
                            Background="{DynamicResource DsgSidebar}"
                            BorderBrush="{DynamicResource DsgBorder}"
                            BorderThickness="0,1,0,0"
                            TextElement.FontSize="11.5">
                        <DockPanel VerticalAlignment="Center">
                            <!--  右侧徽章  -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="minibtn" BorderThickness="0" Command="{Binding ToggleLogPanelCommand}"
                                        ToolTip.Tip="收起/展开运行日志面板">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconCodeScript}" Width="11" Height="11" />
                                        <TextBlock Text="日志" VerticalAlignment="Center" />
                                        <TextBlock Text="▾" VerticalAlignment="Center" IsVisible="{Binding LogPanelVisible}" />
                                        <TextBlock Text="▴" VerticalAlignment="Center" IsVisible="{Binding !LogPanelVisible}" />
                                    </StackPanel>
                                </Button>
                                <Border Classes="sbbadge">
                                    <TextBlock Text="{Binding ProxyModeText}" />
                                </Border>
                                <Border Classes="sbbadge" ToolTip.Tip="302重定向跟随状态（开关在网络设置-请求设置）">
                                    <TextBlock Text="{Binding RedirectModeText}" />
                                </Border>
                                <Border Classes="sbbadge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding AppConfig.DataConfig.SelectedDBType}" />
                                        <TextBlock Text="·" />
                                        <TextBlock Text="{Binding AppConfig.DataConfig.DbEncoding}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="sbbadge">
                                    <TextBlock Text="V2.0.0" />
                                </Border>
                            </StackPanel>
                            <!--  左侧状态组  -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding DetectStatusBrush}" />
                                <TextBlock Text="{Binding DetectStatusText}" FontWeight="SemiBold"
                                           Foreground="{Binding DetectStatusBrush}" VerticalAlignment="Center" />
                                <Border Classes="sbsep" />
                                <ProgressBar Width="16" Height="16" VerticalAlignment="Center"
                                             Theme="{DynamicResource ProgressRing}"
                                             Value="{Binding AppConfig.RuningInfo.Progress}" ShowProgressText="False" />
                                <TextBlock Text="{Binding AppConfig.RuningInfo.Progress, StringFormat={}{0}&#37;}" VerticalAlignment="Center" />
                                <Border Classes="sbsep" />
                                <TextBlock Text="请求" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AppConfig.RequestCount}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="26" />
                                <Border Classes="sbsep" />
                                <TextBlock Text="耗时" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElapsedTime}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40" />
                                <Border Classes="sbsep" />
                                <TextBlock Text="线程" Classes="Secondary" VerticalAlignment="Center" />
                                <u:Int32Displayer VerticalAlignment="Center" Value="{Binding AppConfig.RuningInfo.RunThreadCount}" />
                                <TextBlock Text="/" Classes="Secondary" VerticalAlignment="Center" />
                                <u:Int32Displayer VerticalAlignment="Center" Value="{Binding AppConfig.RuningInfo.MaxThreaadCount}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding DataStatsVisible}">
                                <Border Classes="sbsep" />
                                <TextBlock Text="库" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.DBStructItems.Count}" FontWeight="SemiBold" />
                                <TextBlock Text="表" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.TablesCount}" FontWeight="SemiBold" />
                                <TextBlock Text="字段" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.ColumnsCount}" FontWeight="SemiBold" />
                                <TextBlock Text="数据行" Classes="Secondary" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding AppConfig.DataDump.DataCount}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Panel>
</UserControl>
