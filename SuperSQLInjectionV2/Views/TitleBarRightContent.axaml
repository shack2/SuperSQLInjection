<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="50"
            xmlns:vm="using:SuperSQLInjectionV2.ViewModels"
            x:CompileBindings="True"
            x:DataType="vm:MainViewViewModel"
             x:Class="SuperSQLInjectionV2.Views.TitleBarRightContent">
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,0">
         <!--  开始/停止检测按钮已移至URL输入框后方（主界面URL工具行）  -->
        <!--  跳转 GitHub 代码仓库  -->
        <Button Classes="repo" Width="32" Height="32" Padding="0"
                ToolTip.Tip="GitHub 代码仓库"
                Click="OpenRepo_Click" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconGitHub}" Width="17" Height="17"
                      Foreground="{DynamicResource DsgInk2}" />
        </Button>
        <!--  两态切换：浅色/深色一击即换（三态含"跟随系统"中间态，浅色系統下首击无视觉变化，体验像要点两下）  -->
        <!--  主题切换：浅色/深色单击直接互换（Ursa ThemeToggleButton 三态含"跟随系统"中间态会表现为点两下才切换，且两态模式控件自身抛 Invalid state）  -->
        <Button Classes="repo" Width="32" Height="32" Padding="0"
                ToolTip.Tip="切换浅色/深色主题"
                Click="ToggleTheme_Click" VerticalAlignment="Center">
            <PathIcon Name="ThemeIconPath" Width="15" Height="15"
                  Foreground="{DynamicResource DsgInk2}" />
        </Button>
    </StackPanel>
</UserControl>
