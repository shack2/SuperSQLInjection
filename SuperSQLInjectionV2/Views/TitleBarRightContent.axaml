<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="50"
            xmlns:vm="using:SuperSQLInjectionV2.ViewModels"
            x:CompileBindings="True"
            x:DataType="vm:MainViewViewModel"
             x:Class="SuperSQLInjectionV2.Views.TitleBarRightContent">
    <UserControl.Resources>
        <!--  GitHub Octocat 标记（填充型，Simple Icons 24x24 路径）  -->
        <StreamGeometry x:Key="IconGitHub">M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12</StreamGeometry>
    </UserControl.Resources>
    <UserControl.Styles>
        <!--  仓库跳转按钮：透明底，悬停/按下淡染主色（Semi模板触发器盖Button.Background，需同时定位ContentPresenter）  -->
        <Style Selector="Button.repo">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.repo:pointerover">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint2}" />
        </Style>
        <Style Selector="Button.repo:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint2}" />
        </Style>
        <Style Selector="Button.repo:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DsgPrimaryTint}" />
        </Style>
        <Style Selector="Button.repo:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DsgPrimary}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,0">
         <!--  开始/停止检测按钮已移至URL输入框后方（主界面URL工具行）  -->
        <!--  跳转 GitHub 代码仓库  -->
        <Button Classes="repo" Width="32" Height="32" Padding="0"
                ToolTip.Tip="GitHub 代码仓库"
                Click="OpenRepo_Click" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconGitHub}" Width="17" Height="17"
                      Foreground="{DynamicResource DsgInk2}" />
        </Button>
        <u:ThemeToggleButton
            IsThreeState="True"
            Mode="Controller" />
    </StackPanel>
</UserControl>
