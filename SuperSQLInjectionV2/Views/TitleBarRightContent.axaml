<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="50"
            xmlns:vm="using:SuperSQLInjectionV2.ViewModels"
            x:CompileBindings="True"
            x:DataType="vm:MainViewViewModel"
             x:Class="SuperSQLInjectionV2.Views.TitleBarRightContent">
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,0">
         <!--  开始/停止检测按钮已移至URL输入框后方（主界面URL工具行）  -->
        <!--  跳转 GitHub 代码仓库  -->
        <Button Classes="repo" Width="32" Height="32" Padding="0"
                ToolTip.Tip="GitHub 代码仓库"
                Click="OpenRepo_Click" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconGitHub}" Width="17" Height="17"
                      Foreground="{DynamicResource DsgInk2}" />
        </Button>
        <u:ThemeToggleButton
            IsThreeState="True"
            Mode="Controller" />
    </StackPanel>
</UserControl>
