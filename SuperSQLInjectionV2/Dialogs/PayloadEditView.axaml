<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.PayloadEditView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="860"
    x:CompileBindings="True"
    x:DataType="dialogs:PayloadEditViewModel"
    mc:Ignorable="d">
    <Grid Width="860" Height="600" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="18">

        <!-- 标题 + 技术类型 + 级别 + 风险 -->
        <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto,150,Auto,76,Auto,76">
            <TextBlock Text="标题：" Classes="Secondary" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" />
            <TextBlock Grid.Column="2" Text="技术类型：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ComboBox Grid.Column="3" VerticalAlignment="Center"
                      ItemsSource="{Binding STypeNames}"
                      SelectedItem="{Binding STypeName}" />
            <TextBlock Grid.Column="4" Text="级别：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="5" Minimum="1" Maximum="5" Increment="1"
                           Value="{Binding Level}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="风险：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="7" Minimum="1" Maximum="3" Increment="1"
                           Value="{Binding Risk}" VerticalAlignment="Center" />
        </Grid>

        <!-- Clause + Where + DBMS + 排除 -->
        <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="Auto,110,Auto,110,Auto,*,Auto,*">
            <TextBlock Text="Clause：" Classes="Secondary" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Clause}"
                     ToolTip.Tip="子句适用范围，逗号分隔：1,2,3,8,9" />
            <TextBlock Grid.Column="2" Text="Where：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" VerticalAlignment="Center" Text="{Binding Where}"
                     ToolTip.Tip="拼接方式，逗号分隔：1=拼原值后 2=负值替换 3=整体替换" />
            <TextBlock Grid.Column="4" Text="DBMS：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" VerticalAlignment="Center" Text="{Binding Dbms}"
                     PlaceholderText="如 MySQL，留空通用" />
            <TextBlock Grid.Column="6" Text="排除：" Classes="Secondary" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="7" VerticalAlignment="Center" Text="{Binding DbmsExclude}"
                     PlaceholderText="排除的 DBMS，留空不排除" />
        </Grid>

        <!-- Payload -->
        <TextBlock Grid.Row="2" Margin="0,12,0,5" Classes="Secondary"
                   Text="Payload（支持 [RANDNUM] / [RANDSTR] / [SLEEPTIME] 等占位符）：" />
        <TextBox Grid.Row="3" Classes="TextArea" AcceptsReturn="True" TextWrapping="Wrap"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 Text="{Binding Payload}"
                 PlaceholderText="检测 payload" />

        <!-- Vector -->
        <TextBlock Grid.Row="4" Margin="0,12,0,5" Classes="Secondary"
                   Text="Vector（取数模板，[INFERENCE] / [QUERY] 为取数槽位，可留空）：" />
        <TextBox Grid.Row="5" Classes="TextArea" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="72" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 Text="{Binding Vector}" />

        <!-- 注释 + 文件 + 状态 + 按钮 -->
        <Grid Grid.Row="6" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <TextBlock Text="注释：" Classes="Secondary" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Comment}"
                     PlaceholderText="闭合注释，如 # / --" />
            <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Classes="Secondary" FontSize="11"
                       Text="{Binding FileName, StringFormat='文件：{0}'}" />
            <TextBlock Grid.Column="3" Margin="14,0" VerticalAlignment="Center" Classes="Secondary" FontSize="11"
                       Text="{Binding Status}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10">
                <Button Theme="{DynamicResource SolidButton}" Width="90"
                        Content="保存" Command="{Binding ConfirmCommand}" />
                <Button Theme="{DynamicResource OutlineButton}" Width="90"
                        Content="取消" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
