<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.TokenScriptEditView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:AvaloniaEditor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    d:DesignHeight="640"
    d:DesignWidth="880"
    x:CompileBindings="True"
    x:DataType="dialogs:TokenScriptEditViewModel"
    mc:Ignorable="d">
    <Grid Width="880" Height="640" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="10">

        <!-- 名称 + 用途 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <TextBlock Text="名称：" VerticalAlignment="Center" />
            <TextBox Width="220" VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock Text="用途：" VerticalAlignment="Center" />
            <ComboBox Width="320" VerticalAlignment="Center"
                      ItemsSource="{Binding UsageChoices}"
                      SelectedIndex="{Binding UsageIndex}"
                      ToolTip.Tip="Payload变换：编码链Encode块内payload变换；报文变换：整份HTTP报文改写；响应提取：从抓取响应报文中提取动态值；值生成：以主请求报文为输入生成动态值（API签名等场景）" />
        </StackPanel>

        <!-- 代码编辑区 -->
        <Border Grid.Row="1" Theme="{StaticResource CardBorder}" Padding="0">
            <AvaloniaEditor:TextEditor Name="CodeEditor"
                                       Document="{Binding CodeDocument}"
                                       ShowLineNumbers="True"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       FontWeight="Light" />
        </Border>

        <!-- 验证执行区（验证执行按钮在底部操作行最左侧） -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="测试数据：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                     Classes="TextArea" AcceptsReturn="True" MinHeight="32" MaxHeight="76"
                     TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding TestInput}"
                     PlaceholderText="{Binding TestInputPlaceholder}" />
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,6,0,4" Opacity="0.7" Text="{Binding TestStatus}" />

        <!-- 执行结果 -->
        <TextBox Grid.Row="4" Classes="TextArea" Height="70" AcceptsReturn="True"
                 TextWrapping="Wrap" IsReadOnly="True"
                 HorizontalAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Text="{Binding TestOutput}"
                 PlaceholderText="脚本执行结果" />

        <!-- 操作按钮行：最左验证执行，最右保存/取消 -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <u:IconButton HorizontalAlignment="Left" VerticalAlignment="Center"
                          Theme="{DynamicResource OutlineIconButton}"
                          Icon="{StaticResource SemiIconPlay}"
                          IsLoading="{Binding IsTesting}"
                          Content="验证执行"
                          Command="{Binding TestRunCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Theme="{DynamicResource SolidButton}" Width="90"
                        Content="保 存" Command="{Binding ConfirmCommand}" />
                <Button Theme="{DynamicResource OutlineButton}" Width="90"
                        Content="取 消" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
