<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.DecodeResultView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="480"
    d:DesignWidth="680"
    x:CompileBindings="True"
    x:DataType="dialogs:DecodeResultViewModel"
    mc:Ignorable="d">
    <Grid Width="680" Height="480" RowDefinitions="Auto,*,Auto,2*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Classes="Secondary" Margin="0,0,0,4"
                   Text="{Binding MethodName, StringFormat='解码方式：{0}（无选区时对全文解码）'}" />
        <TextBox Grid.Row="1" Classes="TextArea" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" Text="{Binding SourceText}" />
        <TextBlock Grid.Row="2" Classes="Secondary" Margin="0,8,0,4" Text="解码结果：" />
        <TextBox Grid.Row="3" Classes="TextArea" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" Text="{Binding ResultText}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Theme="{DynamicResource SolidButton}" Content="关闭" Width="90"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
