<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.InjectRecordDetailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="720"
    x:CompileBindings="True"
    x:DataType="dialogs:InjectRecordDetailViewModel"
    mc:Ignorable="d">
    <Grid Width="720" Height="520" RowDefinitions="*,Auto" Margin="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBox Classes="TextArea" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding DetailsText}" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Theme="{DynamicResource SolidButton}" Content="关闭" Width="90"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
