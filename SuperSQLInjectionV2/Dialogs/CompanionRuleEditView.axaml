<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.CompanionRuleEditView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SuperSQLInjectionV2.Models"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:AvaloniaEditor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    d:DesignHeight="640"
    d:DesignWidth="880"
    x:CompileBindings="True"
    x:DataType="dialogs:CompanionRuleEditViewModel"
    mc:Ignorable="d">
    <Grid Width="880" Height="660" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="10">

        <!-- 名称 + 标记名 + 类型 + 启用 -->
        <WrapPanel Grid.Row="0" ItemSpacing="10" Margin="0,0,0,8">
            <TextBlock Text="名称：" VerticalAlignment="Center" />
            <TextBox Width="170" VerticalAlignment="Center" Text="{Binding Rule.Name}" />
            <TextBlock Text="标记名：" VerticalAlignment="Center" />
            <TextBox Width="110" VerticalAlignment="Center" Text="{Binding Rule.TagName}"
                     PlaceholderText="token" ToolTip.Tip="报文中通过 &lt;DRule&gt;标记名:占位值&lt;DRule&gt;（动态值）或 &lt;Sencond:标记名&gt;&lt;/Sencond&gt;（二次注入）关联本规则；留空自动取默认标记名" />
            <TextBlock Text="类型：" VerticalAlignment="Center" />
            <ComboBox Width="260" VerticalAlignment="Center"
                      ItemsSource="{Binding KindNames}"
                      SelectedIndex="{Binding Rule.Kind}"
                      ToolTip.Tip="动态值：主请求前抓取HTTP响应或脚本生成动态值，回填&lt;DRule&gt;标记，可多条同时启用；二次注入：主请求后请求回显页以其响应替代主响应取数，同时只能启用一条" />
            <ToggleSwitch IsChecked="{Binding Rule.Enabled}" VerticalAlignment="Center" />
            <TextBlock Text="启用" Classes="Secondary" VerticalAlignment="Center" />
        </WrapPanel>

        <!-- 请求来源 -->
        <WrapPanel Grid.Row="1" ItemSpacing="10" Margin="0,0,0,8">
            <TextBlock Text="请求来源：" VerticalAlignment="Center" />
            <ComboBox Width="110" VerticalAlignment="Center"
                      ItemsSource="{Binding SourceModes}"
                      SelectedIndex="{Binding Rule.SourceMode}" />
            <TextBlock Text="URL：" VerticalAlignment="Center"
                       IsVisible="{Binding Rule.UrlRowVisible}" />
            <TextBox Width="330" VerticalAlignment="Center" Text="{Binding Rule.Url}"
                     IsVisible="{Binding Rule.UrlRowVisible}"
                     PlaceholderText="http://目标/page.jsp（可含&lt;DRule&gt;标记）" />
            <ComboBox Width="80" VerticalAlignment="Center"
                      ItemsSource="{Binding Methods}"
                      SelectedItem="{Binding Rule.Method}"
                      IsVisible="{Binding Rule.UrlRowVisible}" />
            <TextBlock VerticalAlignment="Center" Classes="Secondary hint"
                       IsVisible="{Binding IsBefore}"
                       Text="主请求含&lt;DRule&gt;标记时，每次发包前自动执行本规则抓取/生成动态值并回填" />
            <TextBlock VerticalAlignment="Center" Classes="Secondary hint"
                       IsVisible="{Binding !IsBefore}"
                       Text="每次注入请求后自动执行本规则，并以其响应替代主响应取数（二次注入场景）" />
        </WrapPanel>

        <!-- 报文编辑区（报文来源时显示，HTTP语法高亮） -->
        <Border Grid.Row="2" Theme="{StaticResource CardBorder}" Padding="0"
                IsVisible="{Binding Rule.PacketEditorVisible}">
            <AvaloniaEditor:TextEditor Name="PacketEditor"
                                       Document="{Binding Rule.TxtRequest}"
                                       ShowLineNumbers="True"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       FontWeight="Light"
                                       Watermark="请复制规则请求页面的完整HTTP请求数据包" />
        </Border>
        <!-- URL来源时编辑区占位：提取规则上移 -->
        <Border Grid.Row="2" IsVisible="{Binding !Rule.PacketEditorVisible}" Height="0" />

        <!-- 提取/生成规则（仅动态值） -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsBefore}">
            <WrapPanel ItemSpacing="10" IsVisible="{Binding Rule.ExtractModeRowVisible}">
                <TextBlock Text="抓取方式：" VerticalAlignment="Center" />
                <CheckBox Content="使用脚本提取" VerticalAlignment="Center"
                          IsChecked="{Binding Rule.UseScript}"
                          ToolTip.Tip="脚本输入为抓取请求返回的完整HTTP响应报文（头+body），输出动态值" />
                <TextBlock VerticalAlignment="Center" Classes="Secondary hint"
                           Text="脚本在 防护绕过-动态值脚本 页统一管理" />
            </WrapPanel>
            <WrapPanel ItemSpacing="10" IsVisible="{Binding Rule.SubstrRowVisible}">
                <TextBlock Text="开始字符：" VerticalAlignment="Center" />
                <TextBox Width="200" VerticalAlignment="Center" Text="{Binding Rule.SubStart}" />
                <TextBlock Text="结束字符：" VerticalAlignment="Center" />
                <TextBox Width="200" VerticalAlignment="Center" Text="{Binding Rule.SubEnd}" />
            </WrapPanel>
            <WrapPanel ItemSpacing="10" IsVisible="{Binding Rule.ScriptRowVisible}">
                <TextBlock Text="执行脚本：" VerticalAlignment="Center" />
                <ComboBox Width="240" VerticalAlignment="Center"
                          ItemsSource="{Binding ScriptItems}"
                          SelectedItem="{Binding SelectedScript}"
                          PlaceholderText="选择脚本（默认取第一个启用脚本）"
                          ToolTip.Tip="脚本提取：输入为抓取响应报文；脚本生成：输入为主请求报文，输出即为动态值（API签名等场景）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ScriptTamperModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="opadd tbtn"
                              Icon="{StaticResource SemiIconPlusStroked}" Content="添加脚本" VerticalAlignment="Center"
                              Command="{Binding AddScriptCommand}"
                              ToolTip.Tip="弹窗新增动态值脚本（按当前来源预设类型），保存后自动选中" />
            </WrapPanel>
        </StackPanel>

        <!-- 测试获取（仅动态值）：按钮+状态一行，结果单独一行 -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding IsBefore}">
            <u:IconButton Grid.Column="0" VerticalAlignment="Center"
                          Theme="{DynamicResource OutlineIconButton}"
                          Icon="{StaticResource SemiIconPlay}"
                          IsLoading="{Binding IsTesting}"
                          Content="测试获取动态值"
                          Command="{Binding TestFetchCommand}" />
            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Opacity="0.7" Text="{Binding TestStatus}" TextWrapping="Wrap" />
        </Grid>
        <TextBox Grid.Row="5" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True"
                 MinHeight="34" MaxHeight="90" TextWrapping="Wrap"
                 IsVisible="{Binding IsBefore}"
                 Text="{Binding TestResult}" PlaceholderText="动态值结果" />
        <!-- 二次注入规则的状态行（校验提示共用TestStatus） -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                   IsVisible="{Binding !IsBefore}" Text="{Binding TestStatus}" />

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Theme="{DynamicResource SolidButton}" Width="90"
                    Content="保 存" Command="{Binding ConfirmCommand}" />
            <Button Theme="{DynamicResource OutlineButton}" Width="90"
                    Content="取 消" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
