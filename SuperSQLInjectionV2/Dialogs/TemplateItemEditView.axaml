<UserControl
    x:Class="SuperSQLInjectionV2.Dialogs.TemplateItemEditView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:SuperSQLInjectionV2.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    d:DesignHeight="420"
    d:DesignWidth="720"
    x:CompileBindings="True"
    x:DataType="dialogs:TemplateItemEditViewModel"
    mc:Ignorable="d">
    <Grid Width="720" Height="420" RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">

        <!-- Key -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <TextBlock Text="模板Key：" VerticalAlignment="Center" />
            <TextBox Width="300" VerticalAlignment="Center" Text="{Binding Key}"
                     PlaceholderText="如 GetDbs / UnionData / ErrorData ..." />
            <TextBlock VerticalAlignment="Center" Opacity="0.6"
                       Text="对应 config/payload/&lt;库&gt;.txt 中的一行 key" />
        </StackPanel>

        <!-- 用途描述（随Key联动，只读） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <TextBlock Text="用途描述：" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"
                       Text="{Binding Desc, FallbackValue='（未知Key，保存时会按自定义key写入模板文件）', TargetNullValue='（未知Key，保存时会按自定义key写入模板文件）'}" />
        </StackPanel>

        <!-- Value（SQL模板，多行） -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="模板Value（SQL模板）：" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" Classes="TextArea" AcceptsReturn="True" TextWrapping="Wrap"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     FontFamily="{StaticResource CodeFontFamily}" FontSize="12.5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding Value}"
                     PlaceholderText="命名占位符：{expr} {cols} {db} {table} {start} {len} {where} {batchSize} {split} {startMark} {endMark} ..." />
        </Grid>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="3" Margin="0,6,0,0" Opacity="0.7" Foreground="{DynamicResource DsgError}" Text="{Binding Status}" />

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Theme="{DynamicResource SolidButton}" Width="90"
                    Content="保 存" Command="{Binding ConfirmCommand}" />
            <Button Theme="{DynamicResource OutlineButton}" Width="90"
                    Content="取 消" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
